    </div>
  </footer>

  <!-- Video Modal -->
  <div id="videoModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/90 backdrop-blur-sm opacity-0 transition-opacity duration-300">
    <div class="relative w-full max-w-6xl mx-auto px-4 sm:px-6">
      <button onclick="closeVideoModal()" class="absolute -top-12 right-4 sm:right-6 text-white/70 hover:text-white transition-colors">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
      <div class="relative w-full rounded-2xl overflow-hidden shadow-2xl bg-black aspect-video">
        <video id="modalVideo" src="" class="w-full h-full object-contain" controls controlsList="nodownload"></video>
      </div>
    </div>
  </div>

  <script>
    function openVideoModal() {
      const modal = document.getElementById('videoModal');
      const modalVid = document.getElementById('modalVideo');
      const heroVid = document.getElementById('dyn-hero-content-video');
      if (modal && modalVid && heroVid) {
        modalVid.src = heroVid.src;
        modal.classList.remove('hidden');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        modalVid.play();
      }
    }

    function closeVideoModal() {
      const modal = document.getElementById('videoModal');
      const modalVid = document.getElementById('modalVideo');
      if (modal && modalVid) {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
          modalVid.pause();
          modalVid.currentTime = 0;
        }, 300);
      }
    }

    const html = document.documentElement;
    const toggleBtn = document.getElementById('darkModeToggle');
    const moonIcon = document.getElementById('moonIcon');
    const sunIcon = document.getElementById('sunIcon');
    const mainHeader = document.getElementById('mainHeader');

    // Header scroll effect
    window.addEventListener('scroll', () => {
      if (window.scrollY > 60) {
        mainHeader.classList.add('header-scrolled');
      } else {
        mainHeader.classList.remove('header-scrolled');
      }
    });

    // Init theme based on localstorage
    if (localStorage.theme === 'light') {
      html.classList.remove('dark');
      sunIcon.classList.add('hidden');
      moonIcon.classList.remove('hidden');
    } else {
      html.classList.add('dark');
    }

    toggleBtn.addEventListener('click', () => {
      if (html.classList.contains('dark')) {
        html.classList.remove('dark');
        localStorage.theme = 'light';
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      } else {
        html.classList.add('dark');
        localStorage.theme = 'dark';
        moonIcon.classList.add('hidden');
        sunIcon.classList.remove('hidden');
      }
    });

    // Mobile Menu Script
    const mobileMenuButton = document.getElementById('mobileMenuButton');
    const mobileMenu = document.getElementById('mobileMenu');
    if(mobileMenuButton && mobileMenu) {
      const mobileNavLinks = mobileMenu.querySelectorAll('a');

      // Tutup menu jika klik di luar area
      document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target) && !mobileMenuButton.contains(e.target)) {
          mobileMenu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
          mobileMenu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
          mobileMenuButton.classList.remove('menu-open');
        }
      });

      mobileMenuButton.addEventListener('click', (e) => {
        e.stopPropagation();
        mobileMenu.classList.toggle('opacity-0');
        mobileMenu.classList.toggle('scale-95');
        mobileMenu.classList.toggle('pointer-events-none');
        
        mobileMenu.classList.toggle('opacity-100');
        mobileMenu.classList.toggle('scale-100');
        mobileMenu.classList.toggle('pointer-events-auto');
        mobileMenuButton.classList.toggle('menu-open');
      });

      mobileNavLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
          mobileMenu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
          mobileMenuButton.classList.remove('menu-open');
        });
      });
    }

    // Animated script to toggle FAQ is now bound dynamically in renderFaq function

    // Scroll typing and fade animation for carousel cards
    const cards = document.querySelectorAll('.carousel-card');
    const observerOptions = {
      root: document.getElementById('productCarousel'), // observe inside carousel
      threshold: 0.6 // trigger when 60% visible
    };
    
    // Fallback if root isn't perfect
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const fadeElems = entry.target.querySelectorAll('.fade-element');
          fadeElems.forEach(el => {
            el.classList.remove('opacity-0', 'translate-y-4');
          });
        } else {
          // Reset animation when scrolled away
          const fadeElems = entry.target.querySelectorAll('.fade-element');
          fadeElems.forEach(el => {
            el.classList.add('opacity-0', 'translate-y-4');
          });
        }
      });
    }, observerOptions);
    cards.forEach(card => observer.observe(card));

    // Scrollspy for Navbar links
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('nav a[data-nav-link]');
    
    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(section => {
        const sectionTop = section.offsetTop;
        const sectionHeight = section.clientHeight;
        if (scrollY >= (sectionTop - 150)) {
          current = section.getAttribute('id');
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('text-white');
        link.classList.add('text-slate-300');
        if (link.getAttribute('href').includes(current)) {
          link.classList.remove('text-slate-300');
          link.classList.add('text-white');
        }
      });
    });


    // Content Reveal Animation
    const revealObserver = new IntersectionObserver((entries) => {
      let delay = 0;
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('active');
          }, delay);
          delay += 100; // Natural stagger for elements appearing together
          revealObserver.unobserve(entry.target); // Animate once for a professional feel
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

    const contentElements = document.querySelectorAll('main h1, main h2, main h3, main p, main img, main .rounded-2xl, main a, footer img, footer p, footer a, footer span, footer h3');
    
    contentElements.forEach((el) => {
      if (!el.classList.contains('fade-element') && !el.closest('header') && !el.classList.contains('no-reveal')) {
        el.classList.add('reveal-element');
        revealObserver.observe(el);
      }
    });


    function escapeServiceHtml(value) {
      return String(value || '').replace(/[&<>'"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
    }

    function isActiveItem(item) {
      return String(item?.status || 'active').toLowerCase() === 'active';
    }

    function formatTimelineLabel(value) {
      return escapeServiceHtml(value).replace(/&amp;bull;/g, '&bull;');
    }

    function toggleCarouselExpand(carouselId, btnId, arrowsId) {
      const carousel = document.getElementById(carouselId);
      const btn = document.getElementById(btnId);
      const arrows = document.getElementById(arrowsId);
      const textEl = btn ? btn.querySelector('span') : null;
      const iconEl = btn ? btn.querySelector('svg') : null;

      const isExpanded = carousel.classList.contains('grid-mode');

      if (!isExpanded) {
        // Switch to grid
        carousel.classList.remove('carousel-mode');
        carousel.classList.add('grid-mode');
        if (arrows) arrows.style.display = 'none';
        if (textEl) textEl.textContent = 'Collapse';
        if (iconEl) iconEl.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>';
      } else {
        // Switch back to carousel
        carousel.classList.remove('grid-mode');
        carousel.classList.add('carousel-mode');
        if (arrows) arrows.style.display = '';
        if (textEl) textEl.textContent = 'Expand';
        if (iconEl) iconEl.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/>';
      }
    }

    function formatServicePublishDate(value) {
      if (!value) return '';
      const parsed = new Date(value);
      if (Number.isNaN(parsed.getTime())) return value;
      return parsed.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }


    function renderServiceCarousel(serviceItems) {
      const carousel = document.getElementById('newServiceCarousel');
      if (!carousel || !serviceItems || serviceItems.length === 0) return;
      const activeServices = serviceItems
        .filter(isActiveItem)
        .sort((a, b) => (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0));
      if (activeServices.length === 0) return;
      carousel.innerHTML = activeServices.map(service => `
        <div class="carousel-card flex flex-col gap-2 sm:gap-3 cursor-pointer group" onclick="window.location.href='/services/${encodeURIComponent(service.slug || '')}'">
          <div class="relative w-full aspect-[4/3] sm:aspect-square rounded-xl sm:rounded-2xl overflow-hidden bg-slate-100 dark:bg-[#1a1a1a]">
            <img src="${escapeServiceHtml(service.image)}" alt="${escapeServiceHtml(service.title)}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 no-reveal" />
          </div>
          <div class="flex flex-col gap-1">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-base sm:text-[1rem] font-semibold text-slate-900 dark:text-white leading-snug">${escapeServiceHtml(service.title)}</h3>
              <p class="text-xs sm:text-[13px] text-slate-500 dark:text-[#a0a0a0] tracking-wide shrink-0 pt-0.5">${escapeServiceHtml(service.category)}</p>
            </div>
            <a href="/services/${encodeURIComponent(service.slug || '')}" class="text-xs sm:text-sm font-medium text-slate-900 dark:text-white group-hover:underline flex items-center gap-1">${escapeServiceHtml(service.button_text || 'Lihat detail')} &gt;</a>
          </div>
        </div>
      `).join('') + '<div class="carousel-spacer"></div>';
    }

    function renderProjectCarousel(projectItems) {
      const carousel = document.getElementById('productCarousel');
      if (!carousel || !projectItems || projectItems.length === 0) return;
      const activeProjects = projectItems
        .filter(isActiveItem)
        .sort((a, b) => (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0));
      if (activeProjects.length === 0) return;
      
      carousel.innerHTML = activeProjects.map(project => `
        <div class="carousel-card flex flex-col gap-2 sm:gap-3 cursor-pointer group" onclick="window.location.href='/portfolio/${encodeURIComponent(project.slug || '')}'">
          <div class="relative w-full aspect-[4/3] sm:aspect-square rounded-xl sm:rounded-2xl overflow-hidden bg-slate-100 dark:bg-[#1a1a1a]">
            <img src="${escapeServiceHtml(project.image)}" alt="${escapeServiceHtml(project.image_alt || project.title)}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 no-reveal" />
          </div>
          <div class="flex flex-col gap-1">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-base sm:text-[1rem] font-semibold text-slate-900 dark:text-white leading-snug">${escapeServiceHtml(project.title)}</h3>
              <p class="text-xs sm:text-[13px] text-slate-500 dark:text-[#a0a0a0] tracking-wide shrink-0 pt-0.5">${escapeServiceHtml(project.category || 'Portfolio')}</p>
            </div>
            <a href="/portfolio/${encodeURIComponent(project.slug || '')}" class="text-xs sm:text-sm font-medium text-slate-900 dark:text-white group-hover:underline flex items-center gap-1">${escapeServiceHtml(project.button_text || 'Lihat detail')} &gt;</a>
          </div>
        </div>
      `).join('') + '<div class="carousel-spacer"></div>';
    }

    function renderTimeline(timelineItems) {
      const container = document.getElementById('timelineContainer');
      if (!container || !timelineItems || timelineItems.length === 0) return;
      const activeItems = timelineItems.filter(isActiveItem).sort((a,b) => (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0));
      
      container.innerHTML = activeItems.map((t, index) => {
        const isLeft = index % 2 === 0;
        return `
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
            <div class="${isLeft ? 'order-2 lg:order-1' : 'order-2 lg:order-2'} flex items-center justify-center relative overflow-hidden rounded-2xl group w-full">
               <img src="${escapeServiceHtml(t.image)}" alt="${escapeServiceHtml(t.image_alt || t.title)}" class="w-full h-auto object-cover rounded-2xl group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'"/>
            </div>
            <div class="${isLeft ? 'order-1 lg:order-2 lg:ml-auto' : 'order-1 lg:order-1 lg:mr-auto'} flex flex-col gap-1 sm:gap-5 max-w-lg mx-auto lg:mx-0">
              <div class="flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-sm font-semibold text-slate-500 dark:text-[#a0a0a0]">
                ${t.icon || ''}
                ${formatTimelineLabel(t.step_label || `Step ${t.step_number}`)}
              </div>
              <h3 class="text-xl sm:text-3xl lg:text-4xl font-semibold text-slate-900 dark:text-white leading-tight">${escapeServiceHtml(t.title)}</h3>
              <p class="text-xs sm:text-base text-slate-600 dark:text-[#a0a0a0] leading-relaxed">
                ${escapeServiceHtml(t.description || t.short_description)}
              </p>
              ${t.button_link ? `
              <a href="${escapeServiceHtml(t.button_link)}" class="text-[11px] sm:text-sm font-medium text-brand-blue hover:text-blue-600 mt-1 sm:mt-2 flex items-center gap-1 transition-colors">${escapeServiceHtml(t.button_text || 'Learn More')} <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    function renderFaq(faqItems) {
      const container = document.getElementById('faqContainer');
      if (!container || !faqItems || faqItems.length === 0) return;

      const activeItems = faqItems.filter(isActiveItem).sort((a,b) => (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0));
      
      let html = '';
      activeItems.forEach(item => {
        html += `
          <div class="faq-item rounded-2xl border border-slate-200 dark:border-white/5 bg-slate-50 dark:bg-[#0a0a0a]">
            <button type="button" class="flex w-full items-center justify-between gap-3 sm:gap-4 p-4 sm:p-6 text-left font-medium text-[13px] sm:text-xl text-slate-900 dark:text-white">
              ${escapeServiceHtml(item.question)}
              <svg class="w-5 h-5 text-slate-600 dark:text-[#a0a0a0] transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="faq-content grid transition-all duration-300 grid-rows-[0fr] opacity-0">
              <div class="overflow-hidden">
                <div class="px-4 pb-4 sm:px-6 sm:pb-6 text-[13px] sm:text-lg leading-relaxed text-slate-600 dark:text-[#a0a0a0]">
                  ${escapeServiceHtml(item.answer).replace(/\n/g, '<br>')}
                </div>
              </div>
            </div>
          </div>
        `;
      });
      container.innerHTML = html;

      // Bind toggle event
      container.querySelectorAll('.faq-item button').forEach(button => {
        button.setAttribute('aria-expanded', 'false');
        button.addEventListener('click', () => {
          const item = button.closest('.faq-item');
          const content = button.nextElementSibling;
          const icon = button.querySelector('svg');
          
          const isOpen = content.classList.contains('grid-rows-[1fr]');
          
          if (isOpen) {
            item.classList.remove('active');
            content.classList.remove('grid-rows-[1fr]', 'opacity-100');
            content.classList.add('grid-rows-[0fr]', 'opacity-0');
            button.setAttribute('aria-expanded', 'false');
            icon.style.transform = 'rotate(0deg)';
          } else {
            item.classList.add('active');
            content.classList.remove('grid-rows-[0fr]', 'opacity-0');
            content.classList.add('grid-rows-[1fr]', 'opacity-100');
            button.setAttribute('aria-expanded', 'true');
            icon.style.transform = 'rotate(180deg)';
          }
        });
      });
    }

    // ─── Hero Background Slider ───────────────────────────────────────────
    let _heroBgInterval = null;

    function initHeroBackgroundSlider(bgArray) {
      const slider = document.getElementById('hero-bg-slider');
      if (!slider || !Array.isArray(bgArray) || bgArray.length === 0) return;

      // Clear any previous interval
      if (_heroBgInterval) clearInterval(_heroBgInterval);

      // Remove fallback static image (first child), keep the gradient overlay
      const gradientOverlay = slider.querySelector('.bg-gradient-to-b');
      slider.innerHTML = '';
      if (gradientOverlay) slider.appendChild(gradientOverlay);

      // Create slide <img> elements for each uploaded background
      bgArray.forEach((url, i) => {
        const img = document.createElement('img');
        img.src = url;
        img.alt = 'Hero Background';
        img.className = 'absolute inset-0 w-full h-full object-cover object-top no-reveal bg-slide';
        img.style.transition = 'opacity 1.5s ease-in-out, transform 6.5s ease-out';
        img.style.opacity = i === 0 ? '1' : '0';
        img.style.transform = i === 0 ? 'scale(1.05)' : 'scale(1)';
        img.style.zIndex = i === 0 ? '1' : '0';
        slider.insertBefore(img, gradientOverlay || null);
      });

      if (bgArray.length === 1) {
         // trigger zoom for single image
         setTimeout(() => {
           const singleImg = slider.querySelector('.bg-slide');
           if (singleImg) singleImg.style.transform = 'scale(1.05)';
         }, 100);
         return;
      }

      let current = 0;
      const slides = slider.querySelectorAll('.bg-slide');

      // trigger zoom for first image
      setTimeout(() => {
        if (slides[0]) slides[0].style.transform = 'scale(1.05)';
      }, 100);

      _heroBgInterval = setInterval(() => {
        const prev = current;
        current = (current + 1) % slides.length;
        
        // Prepare next slide (fade in from 0)
        slides[current].style.transition = 'none';
        slides[current].style.transform = 'scale(1)';
        slides[current].style.opacity = '0';
        slides[current].style.zIndex = '1';
        
        // Put previous slide behind
        slides[prev].style.zIndex = '0';
        
        // force reflow
        void slides[current].offsetWidth;
        
        // Execute fade in and zoom on next slide
        slides[current].style.transition = 'opacity 1.5s ease-in-out, transform 6.5s ease-out';
        slides[current].style.opacity = '1';
        slides[current].style.transform = 'scale(1.05)';
        
        // Clean up previous slide after fade transition finishes (1.5s)
        setTimeout(() => {
          slides[prev].style.transition = 'none';
          slides[prev].style.opacity = '0';
          slides[prev].style.transform = 'scale(1)';
        }, 1500);
      }, 6000);
    }

    // Fetch Settings and Apply
    fetch('/api/settings').then(r => r.json()).then(data => {
      if (data.success && data.settings) {
        if (data.settings.hero) {
          try {
            if (data.settings.hero.title_main) document.getElementById('dyn-hero-title_main').innerHTML = data.settings.hero.title_main;
            if (data.settings.hero.title_gradient) {
              const gradEl = document.getElementById('dyn-hero-title_gradient');
              if (gradEl) {
                const texts = data.settings.hero.title_gradient.split(',').map(s => s.trim()).filter(s => s);
                if (texts.length > 0) {
                  gradEl.style.display = 'inline-grid';
                  gradEl.style.overflow = 'hidden';
                  gradEl.style.verticalAlign = 'bottom';
                  
                  // Get classes to move to children so background-clip works
                  const classes = gradEl.className + ' pb-2 sm:pb-3';
                  gradEl.className = 'inline-grid overflow-hidden whitespace-nowrap -mb-2 sm:-mb-3';
                  
                  const initialSpan = document.createElement('span');
                  initialSpan.textContent = texts[0];
                  initialSpan.className = classes;
                  initialSpan.style.display = 'block';
                  initialSpan.style.gridArea = '1 / 1';
                  initialSpan.style.transform = 'translateY(0)';
                  gradEl.innerHTML = '';
                  gradEl.appendChild(initialSpan);

                  if (texts.length > 1) {
                    let idx = 0;
                    setInterval(() => {
                      const currentSpan = gradEl.children[0];
                      const nextSpan = document.createElement('span');
                      idx = (idx + 1) % texts.length;
                      nextSpan.textContent = texts[idx];
                      nextSpan.className = classes;
                      nextSpan.style.display = 'block';
                      nextSpan.style.gridArea = '1 / 1';
                      nextSpan.style.transform = 'translateY(100%)';
                      nextSpan.style.transition = 'transform 0.6s cubic-bezier(0.22, 1, 0.36, 1)';
                      
                      gradEl.appendChild(nextSpan);
                      
                      currentSpan.style.transition = 'transform 0.6s cubic-bezier(0.22, 1, 0.36, 1)';
                      
                      // Force reflow
                      void gradEl.offsetWidth;
                      
                      currentSpan.style.transform = 'translateY(-100%)';
                      nextSpan.style.transform = 'translateY(0)';
                      
                      setTimeout(() => {
