<!DOCTYPE html>
<html lang="id" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= project ? (project.title + ' - Portfolio Apriprogram') : 'Project Tidak Ditemukan - Apriprogram' %></title>
  <meta name="description" content="<%= project ? (project.short_description || project.description || 'Detail portfolio Apriprogram').replace(/<[^>]+>/g,'').slice(0,160) : 'Portfolio Apriprogram tidak ditemukan' %>">
  <link rel="icon" href="/assets/logo/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Poppins', 'sans-serif'] },
          colors: { brand: { blue: '#243CFF', cyan: '#22D3EE', ink: '#050b14' } }
        }
      }
    };
  </script>
  <script id="apriprogram-theme-init">
    if (localStorage.theme === 'light') document.documentElement.classList.remove('dark');
    else document.documentElement.classList.add('dark');
  </script>
  <style>
    .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s cubic-bezier(.16,1,.3,1), transform 0.7s cubic-bezier(.16,1,.3,1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .project-copy h2, .project-copy h3 { margin-top: 1.75rem; margin-bottom: .75rem; font-size: 1.25rem; font-weight: 600; color: inherit; }
    .project-copy p { margin-bottom: 1.1rem; line-height: 1.8; }
    .project-copy ul, .project-copy ol { margin: 1rem 0; padding-left: 1.5rem; }
    .project-copy ul { list-style: disc; }
    .project-copy ol { list-style: decimal; }
    .project-copy li { margin-bottom: .5rem; }
    .project-copy a { color: #243CFF; text-decoration: underline; }
    .project-copy img { max-width: 100%; border-radius: 1rem; margin: 1.5rem 0; }
    .related-card { transition: transform 0.4s ease; }
    .related-card:hover { transform: translateY(-6px); }
    .related-card:hover .related-image { transform: scale(1.05); }
    .related-image { transition: transform 0.6s cubic-bezier(.16,1,.3,1); }
    .breadcrumb-sep::before { content: '/'; margin: 0 .4rem; color: currentColor; opacity: .4; }
  </style>
</head>
<body class="bg-white text-slate-900 dark:bg-[#0a0a0a] dark:text-white font-sans antialiased selection:bg-brand-blue selection:text-white">

  <!-- Navbar -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200 bg-white/85 backdrop-blur-lg transition-all duration-300 dark:border-white/5 dark:bg-[#050b14]/80" id="mainHeader">
    <nav class="mx-auto flex h-16 max-w-[85%] items-center justify-between px-4 sm:px-6">
      <a href="/#home" class="flex items-center gap-3" aria-label="Apriprogram">
        <img src="/assets/logo/apriprogram.png" alt="Apriprogram Logo" class="h-6 sm:h-8 w-auto" />
        <span class="text-base sm:text-lg font-medium tracking-tight text-slate-900 dark:text-white">Apriprogram</span>
      </a>
      <div class="hidden items-center gap-8 text-sm font-semibold text-slate-600 dark:text-slate-300 lg:flex">
        <a href="/#home" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <a href="/#services" class="hover:text-slate-900 dark:hover:text-white transition-colors">Layanan</a>
        <a href="/portfolio" class="text-slate-900 dark:text-white hover:text-slate-900 dark:hover:text-white transition-colors">Portfolio</a>
        <a href="/#faq" class="hover:text-slate-900 dark:hover:text-white transition-colors">FAQ</a>
        <a href="/#contact" class="hover:text-slate-900 dark:hover:text-white transition-colors">Kontak</a>
      </div>
      <div class="flex items-center gap-4">
        <button id="darkModeToggle" class="p-1 sm:p-2 text-slate-500 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors" aria-label="Toggle Dark Mode">
          <svg id="moonIcon" class="w-4 h-4 sm:w-5 sm:h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          <svg id="sunIcon" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
        <div class="hidden items-center gap-3 lg:flex">
          <% if (user && user.userId) { %>
            <a href="<%= (user.role === 'admin' || user.role === 'super admin') ? '/admin/dashboard' : '/order' %>" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors">Dasbor</a>
            <a href="/logout" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors">Logout</a>
          <% } else { %>
            <a href="/login" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors">Login</a>
          <% } %>
        </div>
        <button id="mobileMenuButton" type="button" class="inline-flex p-1 sm:p-2 flex-col items-center justify-center gap-[3px] sm:gap-1.5 lg:hidden text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
        </button>
      </div>
    </nav>
    <!-- Mobile Menu -->
    <div id="mobileMenu" class="absolute top-[72px] inset-x-4 z-40 flex flex-col bg-white dark:bg-[#0a0a0a] border border-slate-200 dark:border-white/10 p-6 rounded-2xl shadow-2xl lg:hidden opacity-0 scale-95 pointer-events-none transition-all duration-300 origin-top">
      <div class="flex flex-col gap-4 text-sm font-medium text-slate-700 dark:text-slate-300">
        <a href="/#home" class="hover:text-brand-blue dark:hover:text-white transition-colors">Home</a>
        <a href="/#services" class="hover:text-brand-blue dark:hover:text-white transition-colors">Layanan</a>
        <a href="/portfolio" class="text-brand-blue font-semibold">Portfolio</a>
        <a href="/#faq" class="hover:text-brand-blue dark:hover:text-white transition-colors">FAQ</a>
        <a href="/#contact" class="hover:text-brand-blue dark:hover:text-white transition-colors">Kontak</a>
        <div class="h-px w-full bg-slate-200 dark:bg-white/10 my-1"></div>
        <% if (user && user.userId) { %>
          <a href="<%= (user.role === 'admin' || user.role === 'super admin') ? '/admin/dashboard' : '/order' %>" class="hover:text-brand-blue dark:hover:text-white transition-colors">Dasbor</a>
          <a href="/logout" class="text-red-500 hover:text-red-600 transition-colors">Logout</a>
        <% } else { %>
          <a href="/login" class="hover:text-brand-blue dark:hover:text-white transition-colors">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <% if (!project) { %>
    <!-- 404 State -->
    <main class="flex flex-col items-center justify-center min-h-screen text-center px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-blue">404</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-6xl">Project tidak ditemukan</h1>
      <p class="mt-5 text-sm leading-relaxed text-slate-500 dark:text-slate-400 sm:text-base max-w-md">Project yang Anda buka tidak tersedia atau sedang tidak aktif.</p>
      <a href="/portfolio" class="mt-8 inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-white/10 px-5 py-3 text-sm font-semibold text-slate-700 dark:text-white hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Kembali ke Portfolio
      </a>
    </main>

  <% } else { %>
    <%
      const plainDescription = project.description || project.short_description || '';
      const isHtml = plainDescription && /<[^>]+>/.test(plainDescription);
      const heroImg = project.image || project.image_url || '';
      const projectUrl = project.project_url || project.detail_url || '';
    %>
    <main class="pt-16 bg-white dark:bg-[#0a0a0a]">

      <!-- HERO IMAGE SECTION -->
      <section class="relative bg-slate-900 dark:bg-black overflow-hidden min-h-[50vh] sm:min-h-[65vh] flex items-end">
        <% if (heroImg) { %>
          <img src="<%= heroImg %>" alt="<%= project.image_alt || project.title %>" class="absolute inset-0 w-full h-full object-cover opacity-70" onerror="this.remove()">
        <% } else { %>
          <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/30 to-slate-900"></div>
        <% } %>
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>

        <div class="relative z-10 mx-auto max-w-[85%] w-full px-4 sm:px-6 pb-12 sm:pb-16">
          <!-- Breadcrumb -->
          <nav class="flex items-center text-xs text-white/60 mb-6" aria-label="Breadcrumb">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span class="breadcrumb-sep">Portfolio</span>
            <a href="/portfolio" class="hover:text-white transition-colors breadcrumb-sep"><%= project.title %></a>
          </nav>

          <div class="flex flex-col gap-4">
            <% if (project.category) { %>
              <span class="inline-flex w-fit items-center rounded-full bg-brand-blue/80 backdrop-blur px-3 py-1 text-xs font-semibold text-white"><%= project.category %></span>
            <% } %>
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-semibold text-white tracking-tight leading-tight max-w-3xl"><%= project.title %></h1>
            <% if (project.short_description) { %>
              <p class="text-base sm:text-lg text-white/75 max-w-2xl leading-relaxed"><%= project.short_description %></p>
            <% } %>
          </div>
        </div>
      </section>

      <!-- META INFO BAR -->
      <section class="bg-slate-50 dark:bg-[#0f0f0f] border-b border-slate-200 dark:border-white/5">
        <div class="mx-auto max-w-[85%] px-4 sm:px-6 py-6">
          <div class="reveal flex flex-wrap gap-6 sm:gap-10 items-center">
            <% if (project.publish_date || project.date) { %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.15em] text-slate-400 dark:text-[#606060] mb-1">Tanggal</p>
                <p class="text-sm font-medium text-slate-700 dark:text-slate-300"><%= new Date(project.publish_date || project.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
              </div>
            <% } %>
            <% if (project.category) { %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.15em] text-slate-400 dark:text-[#606060] mb-1">Kategori</p>
                <p class="text-sm font-medium text-slate-700 dark:text-slate-300"><%= project.category %></p>
              </div>
            <% } %>
            <% if (project.tech_stack) { %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.15em] text-slate-400 dark:text-[#606060] mb-1">Teknologi</p>
                <p class="text-sm font-medium text-slate-700 dark:text-slate-300"><%= project.tech_stack %></p>
              </div>
            <% } %>
            <% if (project.client_name) { %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.15em] text-slate-400 dark:text-[#606060] mb-1">Klien</p>
                <p class="text-sm font-medium text-slate-700 dark:text-slate-300"><%= project.client_name %></p>
              </div>
            <% } %>
            <% if (projectUrl) { %>
              <div class="ml-auto">
                <a href="<%= projectUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-white/10 px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 hover:text-brand-blue dark:hover:text-brand-blue transition-all">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  Lihat Website
                </a>
              </div>
            <% } %>
          </div>
        </div>
      </section>

      <!-- MAIN CONTENT SECTION -->
      <section class="py-16 sm:py-24 bg-white dark:bg-[#0a0a0a]">
        <div class="mx-auto max-w-[85%] px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-12 lg:gap-16 items-start">

            <!-- Description -->
            <div class="reveal">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-blue mb-4">Deskripsi Proyek</p>
              <h2 class="text-2xl sm:text-4xl font-normal tracking-tight text-slate-900 dark:text-white leading-[1.1] mb-8">Detail proyek</h2>
              <div class="project-copy text-base leading-relaxed text-slate-600 dark:text-slate-400">
                <% if (isHtml) { %>
                  <%- plainDescription %>
                <% } else if (plainDescription) { %>
                  <% plainDescription.split('\n').filter(Boolean).forEach(p => { %>
                    <p><%= p %></p>
                  <% }) %>
                <% } else { %>
                  <p>Proyek ini dikerjakan secara custom sesuai kebutuhan klien oleh tim Apriprogram. Hubungi kami untuk informasi lebih lanjut tentang proyek serupa.</p>
                <% } %>
              </div>

              <!-- Back Button -->
              <div class="mt-12 pt-8 border-t border-slate-200 dark:border-white/5 flex items-center gap-4">
                <a href="/portfolio" class="inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-white/10 px-5 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 hover:-translate-x-1 transition-all">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                  Semua Portfolio
                </a>
                <% if (projectUrl) { %>
                  <a href="<%= projectUrl %>" target="_blank" class="inline-flex items-center gap-2 rounded-full bg-brand-blue px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-600 transition-all hover:-translate-y-0.5">
                    Kunjungi Website
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                <% } %>
              </div>
            </div>

            <!-- Sidebar -->
            <aside class="reveal lg:sticky lg:top-24 flex flex-col gap-5">
              <!-- CTA Card -->
              <div class="rounded-2xl bg-gradient-to-br from-brand-blue to-[#1a2aaa] p-7 text-white relative overflow-hidden">
                <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 20px 20px;"></div>
                <div class="relative z-10">
                  <h3 class="text-lg font-semibold mb-3">Tertarik dengan proyek serupa?</h3>
                  <p class="text-sm text-blue-100 leading-relaxed mb-5">Konsultasikan kebutuhan Anda sekarang dan dapatkan penawaran terbaik dari tim kami.</p>
                  <a href="https://wa.me/6282181361433?text=Halo%2C%20saya%20tertarik%20dengan%20proyek%20seperti%20<%= encodeURIComponent(project.title || '') %>%20di%20Apriprogram" target="_blank" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-brand-blue hover:bg-blue-50 transition-all">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    Hubungi via WhatsApp
                  </a>
                </div>
              </div>

              <!-- Project Info Card -->
              <div class="rounded-2xl border border-slate-200 dark:border-white/5 bg-slate-50 dark:bg-[#111] p-6">
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-4">Info Proyek</h3>
                <dl class="space-y-3 text-sm">
                  <% if (project.category) { %>
                    <div class="flex items-start justify-between gap-4">
                      <dt class="text-slate-500 dark:text-[#606060]">Kategori</dt>
                      <dd class="font-medium text-slate-700 dark:text-slate-300 text-right"><%= project.category %></dd>
                    </div>
                  <% } %>
                  <% if (project.tech_stack) { %>
                    <div class="flex items-start justify-between gap-4">
                      <dt class="text-slate-500 dark:text-[#606060]">Teknologi</dt>
                      <dd class="font-medium text-slate-700 dark:text-slate-300 text-right"><%= project.tech_stack %></dd>
                    </div>
                  <% } %>
                  <% if (project.duration) { %>
                    <div class="flex items-start justify-between gap-4">
                      <dt class="text-slate-500 dark:text-[#606060]">Durasi</dt>
                      <dd class="font-medium text-slate-700 dark:text-slate-300 text-right"><%= project.duration %></dd>
                    </div>
                  <% } %>
                  <% if (project.client_name) { %>
                    <div class="flex items-start justify-between gap-4">
                      <dt class="text-slate-500 dark:text-[#606060]">Klien</dt>
                      <dd class="font-medium text-slate-700 dark:text-slate-300 text-right"><%= project.client_name %></dd>
                    </div>
                  <% } %>
                  <div class="flex items-start justify-between gap-4">
                    <dt class="text-slate-500 dark:text-[#606060]">Status</dt>
                    <dd class="inline-flex items-center gap-1 rounded-full bg-green-100 dark:bg-green-900/30 px-2 py-0.5 text-xs font-semibold text-green-700 dark:text-green-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                      Selesai
                    </dd>
                  </div>
                </dl>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <!-- RELATED PROJECTS -->
      <% if (related && related.length > 0) { %>
        <section class="py-20 bg-slate-50 dark:bg-[#060606] border-t border-slate-200 dark:border-white/5">
          <div class="mx-auto max-w-[85%] px-4 sm:px-6 lg:px-8">
            <div class="reveal flex items-center justify-between gap-4 mb-10">
              <h2 class="text-2xl sm:text-4xl font-normal tracking-tight text-slate-900 dark:text-white">Proyek lainnya</h2>
              <a href="/portfolio" class="flex-shrink-0 inline-flex items-center gap-1.5 text-sm font-medium text-brand-blue hover:gap-2.5 transition-all">
                Lihat semua
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <% related.forEach((rp) => { %>
                <article class="reveal related-card rounded-2xl overflow-hidden border border-slate-200 dark:border-white/5 bg-white dark:bg-[#111] group">
                  <a href="/portfolio/<%= encodeURIComponent(rp.slug || '') %>">
                    <div class="aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-[#1a1a1a]">
                      <% if (rp.image) { %>
                        <img src="<%= rp.image %>" alt="<%= rp.image_alt || rp.title %>" class="related-image w-full h-full object-cover" onerror="this.parentElement.style.background='#1a1a1a'">
                      <% } else { %>
                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-200 to-slate-300 dark:from-[#1a1a1a] dark:to-[#2a2a2a]">
                          <svg class="w-10 h-10 text-slate-400 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                      <% } %>
                    </div>
                    <div class="p-5">
                      <% if (rp.category) { %>
                        <span class="text-xs font-semibold text-brand-blue"><%= rp.category %></span>
                      <% } %>
                      <h3 class="mt-1.5 text-base font-semibold text-slate-900 dark:text-white leading-snug group-hover:text-brand-blue transition-colors"><%= rp.title %></h3>
                      <% if (rp.short_description) { %>
                        <p class="mt-2 text-xs text-slate-500 dark:text-[#a0a0a0] leading-relaxed line-clamp-2"><%= rp.short_description %></p>
                      <% } %>
                      <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-brand-blue group-hover:gap-2 transition-all">
                        Lihat detail
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                      </span>
                    </div>
                  </a>
                </article>
              <% }) %>
            </div>
          </div>
        </section>
      <% } %>

    </main>
  <% } %>

  <!-- Footer -->
  <footer class="border-t border-slate-200 dark:border-white/5 bg-white dark:bg-[#0a0a0a] py-14">
    <div class="mx-auto flex flex-col items-center text-center gap-5 max-w-lg px-4 sm:px-6">
      <a href="/#home" class="flex items-center justify-center gap-2 sm:gap-3">
        <img src="/assets/logo/apriprogram.png" alt="Apriprogram Logo" class="h-7 w-auto" />
        <span class="text-lg font-medium tracking-tight text-slate-900 dark:text-white">Apriprogram</span>
      </a>
      <p class="text-sm leading-relaxed text-slate-500 dark:text-[#a0a0a0]">Membantu perusahaan dan startup menciptakan ekosistem digital terbaik.</p>
    </div>
    <div class="mx-auto mt-10 max-w-[85%] px-4 text-sm text-slate-400 dark:text-[#a0a0a0] sm:px-6 border-t border-slate-200 dark:border-white/5 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p>2026 &copy; Apriprogram. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-slate-900 dark:hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-slate-900 dark:hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </footer>

  <script>
    // Theme
    const html = document.documentElement;
    const toggleBtn = document.getElementById('darkModeToggle');
    const moonIcon = document.getElementById('moonIcon');
    const sunIcon = document.getElementById('sunIcon');
    const applyThemeIcons = () => {
      if (!moonIcon || !sunIcon) return;
      if (html.classList.contains('dark')) { moonIcon.classList.add('hidden'); sunIcon.classList.remove('hidden'); }
      else { sunIcon.classList.add('hidden'); moonIcon.classList.remove('hidden'); }
    };
    if (localStorage.theme === 'light') html.classList.remove('dark');
    else html.classList.add('dark');
    applyThemeIcons();
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        html.classList.toggle('dark');
        localStorage.theme = html.classList.contains('dark') ? 'dark' : 'light';
        applyThemeIcons();
      });
    }

    // Mobile menu
    const mobileMenuButton = document.getElementById('mobileMenuButton');
    const mobileMenu = document.getElementById('mobileMenu');
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('opacity-0'); mobileMenu.classList.toggle('scale-95'); mobileMenu.classList.toggle('pointer-events-none');
        mobileMenu.classList.toggle('opacity-100'); mobileMenu.classList.toggle('scale-100'); mobileMenu.classList.toggle('pointer-events-auto');
      });
      mobileMenu.querySelectorAll('a').forEach(l => l.addEventListener('click', () => {
        mobileMenu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
        mobileMenu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      }));
    }

    // Reveal
    const revealObs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add('visible'), Number(e.target.dataset.delay || 0));
          revealObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.reveal').forEach((el, i) => {
      el.dataset.delay = (i % 3) * 100;
      revealObs.observe(el);
    });

    // Header shadow
    window.addEventListener('scroll', () => {
      document.getElementById('mainHeader').classList.toggle('shadow-sm', window.scrollY > 60);
    });
  </script>
</body>
</html>
