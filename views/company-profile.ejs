<!DOCTYPE html>
<html lang="id" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Company Profile - Apriprogram</title>
  <meta name="description" content="Apriprogram adalah perusahaan jasa pembuatan website custom profesional yang berdedikasi membangun ekosistem digital terbaik untuk bisnis Anda.">
  <link rel="icon" href="/assets/logo/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Poppins', 'sans-serif'] },
          colors: {
            brand: { blue: '#243CFF', cyan: '#22D3EE', ink: '#050b14', card: '#0a111f' }
          },
          animation: {
            'fade-up': 'fadeUp 0.8s ease forwards',
            'fade-in': 'fadeIn 1s ease forwards',
          },
          keyframes: {
            fadeUp: { '0%': { opacity: 0, transform: 'translateY(40px)' }, '100%': { opacity: 1, transform: 'translateY(0)' } },
            fadeIn: { '0%': { opacity: 0 }, '100%': { opacity: 1 } },
          }
        }
      }
    };
  </script>
  <script id="apriprogram-theme-init">
    if (localStorage.theme === 'light') document.documentElement.classList.remove('dark');
    else document.documentElement.classList.add('dark');
  </script>
  <style>
    .reveal { opacity: 0; transform: translateY(40px); transition: opacity 0.8s cubic-bezier(.16,1,.3,1), transform 0.8s cubic-bezier(.16,1,.3,1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .stat-card { transition: transform 0.4s ease, box-shadow 0.4s ease; }
    .stat-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px -10px rgba(36,60,255,0.15); }
    .team-card { transition: transform 0.4s ease, box-shadow 0.4s ease; }
    .team-card:hover { transform: translateY(-8px); box-shadow: 0 24px 48px -12px rgba(0,0,0,0.2); }
    .value-card { transition: all 0.4s ease; border: 1px solid transparent; }
    .value-card:hover { border-color: rgba(36,60,255,0.3); background: rgba(36,60,255,0.03); }
    .hero-glow { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 80vw; height: 60vh; background: radial-gradient(ellipse at 50% 0%, rgba(36,60,255,0.25), transparent 70%); pointer-events: none; }
    .number-counter { font-variant-numeric: tabular-nums; }
    @keyframes countUp { from { opacity: 0; } to { opacity: 1; } }
    .timeline-dot { position: relative; }
    .timeline-dot::before { content: ''; position: absolute; left: 50%; top: 100%; transform: translateX(-50%); width: 2px; height: 100%; background: linear-gradient(to bottom, rgba(36,60,255,0.4), transparent); }
  </style>
</head>
<body class="bg-white text-slate-900 dark:bg-[#0a0a0a] dark:text-white font-sans antialiased selection:bg-brand-blue selection:text-white">

  <!-- Header / Navbar -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200 bg-white/85 backdrop-blur-lg transition-all duration-300 dark:border-white/5 dark:bg-[#050b14]/80" id="mainHeader">
    <nav class="mx-auto flex h-16 max-w-[85%] items-center justify-between px-4 sm:px-6">
      <a href="/#home" class="flex items-center gap-3" aria-label="Apriprogram">
        <img src="/assets/logo/apriprogram.png" alt="Apriprogram Logo" class="h-6 sm:h-8 w-auto" />
        <span class="text-base sm:text-lg font-medium tracking-tight text-slate-900 dark:text-white transition-colors duration-300">Apriprogram</span>
      </a>

      <div class="hidden items-center gap-8 text-sm font-semibold text-slate-600 dark:text-slate-300 lg:flex">
        <a href="/#home" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <a href="/#services" class="hover:text-slate-900 dark:hover:text-white transition-colors">Layanan</a>
        <a href="/#project" class="hover:text-slate-900 dark:hover:text-white transition-colors">Project</a>
        <a href="/#faq" class="hover:text-slate-900 dark:hover:text-white transition-colors">FAQ</a>
        <a href="/#contact" class="hover:text-slate-900 dark:hover:text-white transition-colors">Kontak</a>
      </div>

      <div class="flex items-center gap-4">
        <button id="darkModeToggle" class="p-1 sm:p-2 text-slate-500 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors" aria-label="Toggle Dark Mode">
          <svg id="moonIcon" class="w-4 h-4 sm:w-5 sm:h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          <svg id="sunIcon" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>

        <div class="hidden items-center gap-3 lg:flex">
          <% if (user && user.userId) { %>
            <a href="<%= (user.role === 'admin' || user.role === 'super admin') ? '/admin/dashboard' : '/order' %>" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors mr-2">Dasbor</a>
            <a href="/logout" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors mr-2">Logout</a>
          <% } else { %>
            <a href="/login" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors mr-2">Login</a>
          <% } %>
        </div>

        <button id="mobileMenuButton" type="button" class="inline-flex p-1 sm:p-2 flex-col items-center justify-center gap-[3px] sm:gap-1.5 lg:hidden text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors" aria-label="Buka menu">
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="absolute top-[72px] inset-x-4 z-40 flex flex-col bg-white dark:bg-[#0a0a0a] border border-slate-200 dark:border-white/10 p-6 rounded-2xl shadow-2xl lg:hidden opacity-0 scale-95 pointer-events-none transition-all duration-300 origin-top">
      <div class="flex flex-col gap-4 text-sm font-medium text-slate-700 dark:text-slate-300">
        <a href="/#home" class="hover:text-brand-blue dark:hover:text-white transition-colors">Home</a>
        <a href="/#services" class="hover:text-brand-blue dark:hover:text-white transition-colors">Layanan</a>
        <a href="/#project" class="hover:text-brand-blue dark:hover:text-white transition-colors">Project</a>
        <a href="/#faq" class="hover:text-brand-blue dark:hover:text-white transition-colors">FAQ</a>
        <a href="/#contact" class="hover:text-brand-blue dark:hover:text-white transition-colors">Kontak</a>
        <div class="h-px w-full bg-slate-200 dark:bg-white/10 my-1"></div>
        <% if (user && user.userId) { %>
          <a href="<%= (user.role === 'admin' || user.role === 'super admin') ? '/admin/dashboard' : '/order' %>" class="hover:text-brand-blue dark:hover:text-white transition-colors">Dasbor</a>
          <a href="/logout" class="text-red-500 dark:text-red-400 hover:text-red-600 transition-colors">Logout</a>
        <% } else { %>
          <a href="/login" class="hover:text-brand-blue dark:hover:text-white transition-colors">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="pt-16">

    <!-- HERO SECTION -->
    <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden bg-white dark:bg-[#0a0a0a] border-b border-slate-200 dark:border-white/5">
      <div class="hero-glow"></div>
      <!-- Background grid pattern -->
      <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.06]" style="background-image: linear-gradient(rgba(36,60,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(36,60,255,1) 1px, transparent 1px); background-size: 60px 60px;"></div>

      <div class="relative z-10 mx-auto max-w-[85%] px-4 sm:px-6 py-20 sm:py-32 text-center">
        <div class="reveal mb-6 inline-flex items-center gap-2.5 rounded-full border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.15em] text-slate-600 dark:text-slate-300">
          Company Profile
        </div>
        <h1 class="reveal mx-auto max-w-4xl text-4xl sm:text-6xl lg:text-7xl font-normal tracking-tight text-slate-900 dark:text-white leading-[1.05] mb-6">
          Membangun <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue to-brand-cyan">Ekosistem Digital</span><br>yang Fungsional
        </h1>
        <p class="reveal mx-auto max-w-2xl text-base sm:text-lg text-slate-500 dark:text-[#a0a0a0] leading-relaxed mb-10">
          Apriprogram adalah studio digital yang berdedikasi menciptakan website custom berkualitas tinggi untuk perusahaan, startup, dan UMKM di seluruh Indonesia.
        </p>
        <div class="reveal flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://wa.me/6282181361433?text=Halo%2C%20saya%20tertarik%20dengan%20layanan%20Apriprogram" target="_blank" class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-blue px-6 py-3 text-sm font-semibold text-white hover:bg-blue-600 transition-all hover:-translate-y-0.5">
            Hubungi Kami
          </a>
          <a href="/#services" class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 dark:border-white/10 px-6 py-3 text-sm font-semibold text-slate-900 dark:text-white hover:bg-slate-50 dark:hover:bg-white/5 transition-all hover:-translate-y-0.5">
            Lihat Layanan
          </a>
        </div>
      </div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="py-24 bg-slate-50 dark:bg-[#0a0a0a]">
      <div class="mx-auto max-w-[85%] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
          <div class="reveal">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-blue mb-4">Tentang Kami</p>
            <h2 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-normal tracking-tight text-slate-900 dark:text-white leading-[1.05] mb-6">
              Siapa Kami?
            </h2>
            <p class="text-base sm:text-lg text-slate-600 dark:text-[#a0a0a0] leading-relaxed mb-6">
              Apriprogram adalah studio pengembangan website custom yang lahir dari semangat untuk membantu bisnis Indonesia bertransformasi secara digital. Kami percaya bahwa setiap bisnis berhak memiliki kehadiran online yang profesional, fungsional, dan mencerminkan identitas brand mereka.
            </p>
            <p class="text-base text-slate-500 dark:text-[#808080] leading-relaxed">
              Dengan pengalaman mengerjakan berbagai proyek — mulai dari company profile, toko online, hingga sistem manajemen operasional — kami berkomitmen menghadirkan solusi digital yang bukan sekadar estetis, tetapi benar-benar bekerja untuk pertumbuhan bisnis Anda.
            </p>
          </div>
          <div class="reveal grid grid-cols-2 gap-4">
            <div class="stat-card col-span-2 rounded-2xl bg-white dark:bg-[#111] border border-slate-200 dark:border-white/5 p-8 text-center">
              <div class="text-5xl sm:text-6xl font-light text-brand-blue mb-2 number-counter" data-target="50">0+</div>
              <p class="text-sm font-medium text-slate-500 dark:text-[#a0a0a0]">Project Selesai</p>
            </div>
            <div class="stat-card rounded-2xl bg-white dark:bg-[#111] border border-slate-200 dark:border-white/5 p-6 text-center">
              <div class="text-4xl font-light text-slate-900 dark:text-white mb-2">3+</div>
              <p class="text-xs font-medium text-slate-500 dark:text-[#a0a0a0]">Tahun Berpengalaman</p>
            </div>
            <div class="stat-card rounded-2xl bg-white dark:bg-[#111] border border-slate-200 dark:border-white/5 p-6 text-center">
              <div class="text-4xl font-light text-slate-900 dark:text-white mb-2">100%</div>
              <p class="text-xs font-medium text-slate-500 dark:text-[#a0a0a0]">Kepuasan Klien</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VISI & MISI -->
    <section class="py-24 bg-white dark:bg-[#060606] border-t border-b border-slate-200 dark:border-white/5">
      <div class="mx-auto max-w-[85%] px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-blue mb-4">Visi & Misi</p>
          <h2 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-normal tracking-tight text-slate-900 dark:text-white leading-[1.05]">
            Arah & Tujuan Kami
          </h2>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Visi -->
          <div class="reveal value-card rounded-2xl bg-slate-50 dark:bg-[#0f0f0f] p-8 sm:p-10">
            <div class="mb-6 inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-blue/10">
              <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </div>
            <h3 class="text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white mb-4">Visi</h3>
            <p class="text-base text-slate-600 dark:text-[#a0a0a0] leading-relaxed">
              Menjadi studio digital terdepan di Indonesia yang dipercaya oleh perusahaan-perusahaan dalam membangun identitas dan ekosistem digital mereka secara profesional, modern, dan berkelanjutan.
            </p>
          </div>
          <!-- Misi -->
          <div class="reveal value-card rounded-2xl bg-slate-50 dark:bg-[#0f0f0f] p-8 sm:p-10">
            <div class="mb-6 inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-cyan/10">
              <svg class="w-6 h-6 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white mb-4">Misi</h3>
            <ul class="space-y-3 text-base text-slate-600 dark:text-[#a0a0a0]">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-brand-cyan flex-shrink-0"></span>
                <span>Menghadirkan layanan pengembangan website berkualitas tinggi dengan harga terjangkau.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-brand-cyan flex-shrink-0"></span>
                <span>Membangun solusi digital yang benar-benar berfungsi dan mendukung pertumbuhan bisnis klien.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-brand-cyan flex-shrink-0"></span>
                <span>Memberikan pelayanan penuh transparansi, komunikasi cepat, dan after-service yang andal.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- NILAI-NILAI / VALUES -->
    <section class="py-24 bg-slate-50 dark:bg-[#0a0a0a]">
      <div class="mx-auto max-w-[85%] px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-blue mb-4">Nilai Kami</p>
          <h2 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-normal tracking-tight text-slate-900 dark:text-white leading-[1.05]">
            Prinsip yang Kami Pegang
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="reveal value-card rounded-2xl bg-white dark:bg-[#111] border border-slate-200 dark:border-white/5 p-7">
            <div class="mb-5 text-3xl">🎯</div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-3">Fokus pada Kualitas</h3>
            <p class="text-sm text-slate-500 dark:text-[#a0a0a0] leading-relaxed">Setiap baris kode dan setiap elemen desain dibuat dengan standar tinggi dan perhatian penuh terhadap detail.</p>
          </div>
          <div class="reveal value-card rounded-2xl bg-white dark:bg-[#111] border border-slate-200 dark:border-white/5 p-7">
            <div class="mb-5 text-3xl">⚡</div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-3">Eksekusi Cepat</h3>
            <p class="text-sm text-slate-500 dark:text-[#a0a0a0] leading-relaxed">Kami menghargai waktu klien. Setiap proyek dikerjakan tepat waktu tanpa mengorbankan kualitas hasil.</p>
          </div>
          <div class="reveal value-card rounded-2xl bg-white dark:bg-[#111] border border-slate-200 dark:border-white/5 p-7">
            <div class="mb-5 text-3xl">🤝</div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-3">Transparansi</h3>
            <p class="text-sm text-slate-500 dark:text-[#a0a0a0] leading-relaxed">Komunikasi terbuka, harga jelas, dan proses yang dapat dipantau dari awal hingga selesai.</p>
          </div>
          <div class="reveal value-card rounded-2xl bg-white dark:bg-[#111] border border-slate-200 dark:border-white/5 p-7">
            <div class="mb-5 text-3xl">🚀</div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-3">Berorientasi Pertumbuhan</h3>
            <p class="text-sm text-slate-500 dark:text-[#a0a0a0] leading-relaxed">Solusi yang kami bangun dirancang untuk mendukung skalabilitas bisnis klien jangka panjang.</p>
          </div>
          <div class="reveal value-card rounded-2xl bg-white dark:bg-[#111] border border-slate-200 dark:border-white/5 p-7">
            <div class="mb-5 text-3xl">💡</div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-3">Inovasi Berkelanjutan</h3>
            <p class="text-sm text-slate-500 dark:text-[#a0a0a0] leading-relaxed">Kami terus mengikuti perkembangan teknologi terbaru untuk memberikan solusi yang relevan dan modern.</p>
          </div>
          <div class="reveal value-card rounded-2xl bg-white dark:bg-[#111] border border-slate-200 dark:border-white/5 p-7">
            <div class="mb-5 text-3xl">🛡️</div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-3">After-Service Andal</h3>
            <p class="text-sm text-slate-500 dark:text-[#a0a0a0] leading-relaxed">Proyek selesai bukan berarti hubungan berakhir. Kami siap mendukung klien setelah website diluncurkan.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- LAYANAN UTAMA -->
    <section class="py-24 bg-white dark:bg-[#060606] border-t border-slate-200 dark:border-white/5">
      <div class="mx-auto max-w-[85%] px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row gap-8 lg:gap-20 justify-between items-start mb-16">
          <div class="reveal">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-blue mb-4">Layanan</p>
            <h2 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-normal tracking-tight text-slate-900 dark:text-white leading-[1.05]">
              Apa yang Kami Kerjakan
            </h2>
          </div>
          <div class="reveal max-w-md pt-2">
            <p class="text-sm sm:text-base text-slate-500 dark:text-[#a0a0a0] leading-relaxed">
              Dari desain UI yang memukau hingga sistem backend yang tangguh — kami hadir sebagai mitra teknologi digital Anda.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-slate-200 dark:bg-white/5 rounded-2xl overflow-hidden border border-slate-200 dark:border-white/5">
          <div class="reveal bg-white dark:bg-[#0a0a0a] p-8 sm:p-10 hover:bg-slate-50 dark:hover:bg-[#0f0f0f] transition-colors">
            <div class="mb-4 w-10 h-10 rounded-xl bg-brand-blue/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
