    .reveal { opacity: 0; transform: translateY(32px); transition: opacity 0.7s cubic-bezier(.16,1,.3,1), transform 0.7s cubic-bezier(.16,1,.3,1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .project-card { transition: transform 0.4s ease, box-shadow 0.4s ease; }
    .project-card:hover .card-image { transform: scale(1.05); }
    .card-image { transition: transform 0.7s cubic-bezier(.16,1,.3,1); }
    .project-card:hover .card-overlay { opacity: 1; }
    .card-overlay { transition: opacity 0.4s ease; opacity: 0; }
    .project-card:hover .card-arrow { transform: translate(3px, -3px); }
    .card-arrow { transition: transform 0.3s ease; }
    .filter-btn { transition: all 0.3s ease; }
    .filter-btn.active { background: #243CFF; color: white; border-color: #243CFF; }
    #mainHeader { border:0; outline:0; box-shadow:none; }
