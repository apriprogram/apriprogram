<!DOCTYPE html>
<html lang="id" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Semua Layanan - Apriprogram</title>
  <meta name="description" content="Daftar lengkap layanan digital Apriprogram untuk website, aplikasi web, toko online, SEO, dan sistem bisnis custom.">
  <link rel="icon" href="/assets/logo/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Poppins', 'sans-serif'] },
          colors: { brand: { blue: '#243CFF', ink: '#050b14' } }
        }
      }
    };
  </script>
  <script id="apriprogram-theme-init">
    if (localStorage.theme === 'light') document.documentElement.classList.remove('dark');
    else document.documentElement.classList.add('dark');
  </script>
    <link rel="stylesheet" href="/css/style.css">
  <style>
    @keyframes serviceFadeUp {
      from { opacity: 0; transform: translateY(26px); filter: blur(8px); }
      to { opacity: 1; transform: translateY(0); filter: blur(0); }
    }
    .service-reveal {
      opacity: 0;
      transform: translateY(26px);
      filter: blur(8px);
      will-change: opacity, transform, filter;
    }
    .service-reveal.is-visible {
      animation: serviceFadeUp .85s cubic-bezier(.16, 1, .3, 1) forwards;
      animation-delay: var(--delay, 0ms);
    }
  </style>
</head>
<body class="bg-white text-slate-950 dark:bg-[#0a0a0a] dark:text-white font-sans antialiased selection:bg-brand-blue selection:text-white transition-colors duration-300">
  <header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200 bg-white/85 backdrop-blur-lg transition-all duration-300 dark:border-white/5 dark:bg-[#050b14]/60" id="mainHeader">
    <nav class="mx-auto flex h-16 max-w-[85%] items-center justify-between px-4 sm:px-6">
      <a href="/#home" class="flex items-center gap-3" aria-label="Apriprogram">
        <img src="/assets/logo/apriprogram.png" alt="Apriprogram Logo" class="h-6 sm:h-8 w-auto" />
        <span class="nav-text text-base sm:text-lg font-medium tracking-tight text-slate-950 transition-colors duration-300 dark:text-white">Apriprogram</span>
      </a>

      <div id="dyn-desktop-menu" class="hidden items-center gap-8 text-sm font-semibold text-slate-600 dark:text-slate-300 lg:flex">
        <a data-nav-link href="/#home" class="nav-link hover:text-slate-950 dark:hover:text-white transition-colors">Home</a>
        <a data-nav-link href="/#services" class="nav-link text-slate-950 dark:text-white hover:text-slate-950 dark:hover:text-white transition-colors">Layanan</a>
        <a data-nav-link href="/#project" class="nav-link hover:text-slate-950 dark:hover:text-white transition-colors">Project</a>
        <a data-nav-link href="/#faq" class="nav-link hover:text-slate-950 dark:hover:text-white transition-colors">FAQ</a>
        <a data-nav-link href="/#contact" class="nav-link hover:text-slate-950 dark:hover:text-white transition-colors">Kontak</a>
      </div>

      <div class="flex items-center gap-4">
        <button id="darkModeToggle" class="p-1 sm:p-2 text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-white transition-colors" aria-label="Toggle Dark Mode">
          <svg id="moonIcon" class="w-4 h-4 sm:w-5 sm:h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          <svg id="sunIcon" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>

        <div class="hidden items-center gap-3 lg:flex">
          <% if (user && user.userId) { %>
            <a href="<%= (user.role === 'admin' || user.role === 'super admin') ? '/admin/dashboard' : '/order' %>" class="nav-link text-sm font-semibold text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-white transition-colors mr-2">Dasbor</a>
            <a href="/logout" class="nav-link text-sm font-semibold text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-white transition-colors mr-2">Logout</a>
          <% } else { %>
            <a href="/login" class="nav-link text-sm font-semibold text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-white transition-colors mr-2">Login</a>
          <% } %>
        </div>

        <button id="mobileMenuButton" type="button" class="inline-flex p-1 sm:p-2 flex-col items-center justify-center gap-[3px] sm:gap-1.5 lg:hidden text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-white transition-colors" aria-label="Buka menu">
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-950 transition-colors dark:bg-white"></span>
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-950 transition-colors dark:bg-white"></span>
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-950 transition-colors dark:bg-white"></span>
        </button>
      </div>
    </nav>

    <div id="mobileMenu" class="absolute top-[72px] inset-x-4 z-40 flex flex-col bg-white dark:bg-[#0a0a0a] border border-slate-200 dark:border-white/10 p-6 rounded-2xl shadow-2xl lg:hidden opacity-0 scale-95 pointer-events-none transition-all duration-300 origin-top">
      <div class="flex flex-col gap-4 text-sm font-medium text-slate-900 dark:text-slate-300">
        <div id="dyn-mobile-links" class="flex flex-col gap-4">
          <a data-nav-link href="/#home" class="hover:text-brand-blue dark:hover:text-white transition-colors">Home</a>
          <a data-nav-link href="/#services" class="hover:text-brand-blue dark:hover:text-white transition-colors">Layanan</a>
          <a data-nav-link href="/#project" class="hover:text-brand-blue dark:hover:text-white transition-colors">Project</a>
          <a data-nav-link href="/#faq" class="hover:text-brand-blue dark:hover:text-white transition-colors">FAQ</a>
          <a data-nav-link href="/#contact" class="hover:text-brand-blue dark:hover:text-white transition-colors">Kontak</a>
        </div>
        <div class="h-px w-full bg-slate-200 dark:bg-white/10 my-2"></div>
        <% if (user && user.userId) { %>
          <a href="<%= (user.role === 'admin' || user.role === 'super admin') ? '/admin/dashboard' : '/order' %>" class="hover:text-brand-blue dark:hover:text-white transition-colors">Dasbor</a>
          <a href="/logout" class="text-red-500 dark:text-red-400 hover:text-red-600 dark:hover:text-red-300 transition-colors">Logout</a>
        <% } else { %>
          <a href="/login" class="hover:text-brand-blue dark:hover:text-white transition-colors">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="pt-16 bg-white dark:bg-[#0a0a0a] transition-colors duration-300">
    <section class="mx-auto max-w-[92%] px-4 py-14 sm:max-w-[86%] sm:py-20">
      <div class="service-reveal flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-3xl">
<p class="text-sm font-semibold text-slate-500 dark:text-slate-400">Layanan Apriprogram</p>
          <h1 class="mt-4 max-w-4xl text-4xl font-normal leading-[1.05] tracking-tight text-slate-950 dark:text-white sm:text-5xl lg:text-6xl">Semua layanan digital untuk membangun bisnis Anda.</h1>
          <p class="mt-7 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-400">Pilih layanan yang sesuai dengan kebutuhan bisnis Anda. Setiap layanan dapat dibuka untuk melihat deskripsi lengkap dan media pendukung.</p>
        </div>
        <a href="/#services" class="inline-flex w-fit items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-blue hover:text-brand-blue hover:shadow-lg dark:border-white/10 dark:bg-transparent dark:text-white dark:hover:border-brand-blue dark:hover:text-white"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>Kembali ke beranda</a>
      </div>

      <% const getServiceImage = (service) => { const media = Array.isArray(service.media_items) ? service.media_items.find((item) => item && item.type !== 'video' && item.url) : null; return service.image_url || service.image || (media && media.url) || '/assets/hero/hero_konten.jpg'; }; %>
      <% const getServiceText = (service) => String(service.short_description || service.description || 'Detail layanan tersedia pada halaman lengkap.').replace(/<[^>]+>/g, ''); %>

      <% if (services && services.length) { %>
        <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
          <% services.forEach((service, index) => { %>
            <article class="service-reveal group overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-50 transition duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-slate-200/70 dark:border-white/10 dark:bg-white/[0.04] dark:hover:border-brand-blue/60 dark:hover:shadow-brand-blue/10" style="--delay: <%= Math.min(index * 90, 450) %>ms">
              <a href="/services/<%= encodeURIComponent(service.slug || '') %>" class="block h-full">
                <div class="aspect-[5/5.85] overflow-hidden bg-slate-100 dark:bg-white/[0.06]">
                  <img src="<%= getServiceImage(service) %>" alt="<%= service.title || 'Layanan Apriprogram' %>" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" onerror="this.src='/assets/hero/hero_konten.jpg'">
                </div>
                <div class="space-y-4 bg-white p-6 dark:bg-[#101010]">
                  <div class="flex flex-wrap gap-3 text-sm text-slate-500 dark:text-slate-400">
                    <% if (service.publish_date) { %><span><%= service.publish_date %></span><% } %>
                    <% if (service.category) { %><span><%= service.category %></span><% } %>
                  </div>
                  <h2 class="text-2xl font-semibold tracking-tight text-slate-950 dark:text-white"><%= service.title || 'Layanan Apriprogram' %></h2>
                  <p class="text-sm leading-7 text-slate-600 dark:text-slate-400"><%= getServiceText(service).slice(0, 170) %><%= getServiceText(service).length > 170 ? '...' : '' %></p>
                  <span class="inline-flex text-sm font-semibold text-slate-950 underline underline-offset-4 group-hover:text-brand-blue dark:text-white dark:group-hover:text-blue-300">Read details &gt;</span>
                </div>
              </a>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="service-reveal mt-14 rounded-[1.75rem] border border-slate-200 bg-slate-50 p-10 text-center dark:border-white/10 dark:bg-white/[0.04]">
          <h2 class="text-2xl font-semibold text-slate-950 dark:text-white">Belum ada layanan aktif.</h2>
          <p class="mt-3 text-slate-600 dark:text-slate-400">Tambahkan atau aktifkan layanan dari admin panel.</p>
        </div>
      <% } %>
    </section>
  </main>

  <footer class="border-t border-white/5 bg-[#0a0a0a] py-16">
    <div class="mx-auto flex flex-col items-center text-center gap-6 max-w-lg px-4 sm:px-6 lg:px-8">
      <a href="/#home" class="flex items-center justify-center gap-2 sm:gap-3">
        <img src="/assets/logo/apriprogram.png" alt="Apriprogram Logo" class="h-6 sm:h-8 w-auto" />
        <span class="text-lg sm:text-xl font-medium tracking-tight text-white">Apriprogram</span>
      </a>
      <p class="text-sm leading-relaxed text-[#a0a0a0]" id="dyn-footer-description">
        Membantu perusahaan, agensi, dan startup menciptakan ekosistem digital terbaik yang modern dan fungsional.
      </p>
    </div>
    <div class="mx-auto mt-16 max-w-[85%] px-4 text-sm text-[#a0a0a0] sm:px-6 lg:px-8 border-t border-white/5 pt-8 text-center sm:text-left flex flex-col sm:flex-row justify-between items-center gap-4">
      <p id="dyn-footer-copyright">2026 &copy; Apriprogram. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </footer>

  <script>
    const html = document.documentElement;
    const toggleBtn = document.getElementById('darkModeToggle');
    const moonIcon = document.getElementById('moonIcon');
    const sunIcon = document.getElementById('sunIcon');

    const applyThemeIcons = () => {
      if (!moonIcon || !sunIcon) return;
      if (html.classList.contains('dark')) {
        moonIcon.classList.add('hidden');
        sunIcon.classList.remove('hidden');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    };

    if (localStorage.theme === 'light') html.classList.remove('dark');
    else html.classList.add('dark');
    applyThemeIcons();

    if (toggleBtn && moonIcon && sunIcon) {
      toggleBtn.addEventListener('click', () => {
        if (html.classList.contains('dark')) {
          html.classList.remove('dark');
          localStorage.theme = 'light';
        } else {
          html.classList.add('dark');
          localStorage.theme = 'dark';
        }
        applyThemeIcons();
      });
    }

    const mobileMenuButton = document.getElementById('mobileMenuButton');
    const mobileMenu = document.getElementById('mobileMenu');
    if (mobileMenuButton && mobileMenu) {
      const mobileNavLinks = mobileMenu.querySelectorAll('a');
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('opacity-0');
        mobileMenu.classList.toggle('scale-95');
        mobileMenu.classList.toggle('pointer-events-none');
        mobileMenu.classList.toggle('opacity-100');
        mobileMenu.classList.toggle('scale-100');
        mobileMenu.classList.toggle('pointer-events-auto');
      });
      mobileNavLinks.forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
          mobileMenu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
        });
      });
    }


    const revealItems = document.querySelectorAll('.service-reveal');
    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14 });
      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    }
    const normalizeHomeUrl = (url) => {
      if (!url || url === '#') return '/#home';
      return url.startsWith('#') ? `/${url}` : url;
    };

    fetch('/api/settings')
      .then((response) => response.ok ? response.json() : null)
      .then((data) => {
        if (!data || !data.settings) return;

        if (data.settings.navbar) {
          const logoText = document.querySelector('header nav a[aria-label="Apriprogram"] span');
          const logoImg = document.querySelector('header nav a[aria-label="Apriprogram"] img');
          if (logoText && data.settings.navbar.logo_text) logoText.innerHTML = data.settings.navbar.logo_text;
          if (logoImg && data.settings.navbar.logo_image) logoImg.src = data.settings.navbar.logo_image;

          if (data.settings.navbar.nav_links_data) {
            try {
              const navLinks = JSON.parse(data.settings.navbar.nav_links_data);
              const desktopMenu = document.getElementById('dyn-desktop-menu');
              const mobileMenuLinks = document.getElementById('dyn-mobile-links');
              if (Array.isArray(navLinks) && navLinks.length) {
                if (desktopMenu) {
                  desktopMenu.innerHTML = navLinks.map((link) => {
                    const url = normalizeHomeUrl(link.url);
                    const active = url.includes('#services') ? 'text-slate-950 dark:text-white' : 'text-slate-600 dark:text-slate-300';
                    return `<a data-nav-link href="${url}" class="nav-link hover:text-slate-950 dark:hover:text-white transition-colors ${active}">${link.text}</a>`;
                  }).join('');
                }
                if (mobileMenuLinks) {
                  mobileMenuLinks.innerHTML = navLinks.map((link) => `<a data-nav-link href="${normalizeHomeUrl(link.url)}" class="hover:text-brand-blue dark:hover:text-white transition-colors">${link.text}</a>`).join('');
                  mobileMenuLinks.querySelectorAll('a').forEach((link) => {
                    link.addEventListener('click', () => {
                      mobileMenu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
                      mobileMenu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
                    });
                  });
                }
              }
            } catch (error) {
              console.error('Navbar settings error:', error);
            }
          }
        }

        if (data.settings.footer) {
          const footerDescription = document.getElementById('dyn-footer-description');
          const footerCopyright = document.getElementById('dyn-footer-copyright');
          if (footerDescription && data.settings.footer.description) footerDescription.innerHTML = data.settings.footer.description;
          if (footerCopyright && data.settings.footer.copyright) footerCopyright.innerHTML = data.settings.footer.copyright;
        }
      })
      .catch((error) => console.error('Settings load error:', error));
  </script>
</body>
</html>