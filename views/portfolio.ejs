<!DOCTYPE html>
<html lang="id" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portofolio & Klien Jasa Pembuatan Website | Apriprogram</title>
  <meta name="description" content="Lihat daftar karya terbaik dan klien Apriprogram. Kami telah membantu berbagai bisnis mencapai tujuannya dengan solusi website dan sistem digital modern.">
  <meta name="keywords" content="portofolio website, klien apriprogram, contoh desain website, hasil kerja web developer, jasa pembuatan website">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://apriprogram.com/portfolio">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://apriprogram.com/portfolio">
  <meta property="og:title" content="Portofolio & Klien Jasa Pembuatan Website | Apriprogram">
  <meta property="og:description" content="Lihat daftar karya terbaik dan klien Apriprogram. Kami telah membantu berbagai bisnis mencapai tujuannya dengan solusi website dan sistem digital modern.">
  <meta property="og:image" content="https://apriprogram.com/assets/logo/favicon.png">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://apriprogram.com/portfolio">
  <meta property="twitter:title" content="Portofolio & Klien Jasa Pembuatan Website | Apriprogram">
  <meta property="twitter:description" content="Lihat daftar karya terbaik dan klien Apriprogram. Kami telah membantu berbagai bisnis mencapai tujuannya dengan solusi website dan sistem digital modern.">
  <meta property="twitter:image" content="https://apriprogram.com/assets/logo/favicon.png">
  <link rel="icon" href="/assets/logo/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Poppins', 'sans-serif'] },
          colors: { brand: { blue: '#243CFF', cyan: '#22D3EE', ink: '#050b14' } }
        }
      }
    };
  </script>
  <script id="apriprogram-theme-init">
    if (localStorage.theme === 'light') document.documentElement.classList.remove('dark');
    else document.documentElement.classList.add('dark');
  </script>
  <style>
    .reveal { opacity: 0; transform: translateY(32px); transition: opacity 0.7s cubic-bezier(.16,1,.3,1), transform 0.7s cubic-bezier(.16,1,.3,1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .project-card { transition: transform 0.4s ease, box-shadow 0.4s ease; }
    .project-card:hover .card-image { transform: scale(1.05); }
    .card-image { transition: transform 0.7s cubic-bezier(.16,1,.3,1); }
    .project-card:hover .card-overlay { opacity: 1; }
    .card-overlay { transition: opacity 0.4s ease; opacity: 0; }
    .project-card:hover .card-arrow { transform: translate(3px, -3px); }
    .card-arrow { transition: transform 0.3s ease; }
    .filter-btn { transition: all 0.3s ease; }
    .filter-btn.active { background: #243CFF; color: white; border-color: #243CFF; }
    #mainHeader { border: 0; outline: 0; box-shadow: none; }
    #mainHeader:not(.header-scrolled) { background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
    #mainHeader.header-scrolled { background: rgba(255,255,255,.68); backdrop-filter: blur(22px) saturate(180%); -webkit-backdrop-filter: blur(22px) saturate(180%); }
    .dark #mainHeader.header-scrolled { background: rgba(5,11,20,.62); backdrop-filter: blur(22px) saturate(170%); -webkit-backdrop-filter: blur(22px) saturate(170%); }
    #mainHeader a:not([aria-label="Apriprogram"]), #mainHeader button { font-weight: 400 !important; }
    #mainHeader #languageToggle, #mainHeader #languageToggle:hover { background: transparent !important; }
    html:not(.dark) body > #mobileMenu { position:fixed!important; background:linear-gradient(145deg,rgba(255,255,255,.86),rgba(248,250,252,.78))!important; background-color:transparent!important; border-color:rgba(255,255,255,.72)!important; box-shadow:0 18px 50px rgba(15,23,42,.14),inset 0 1px 0 rgba(255,255,255,.9)!important; backdrop-filter:blur(28px) saturate(190%)!important; -webkit-backdrop-filter:blur(28px) saturate(190%)!important; }
    html.dark body > #mobileMenu { position:fixed!important; background:linear-gradient(145deg,rgba(15,23,42,.84),rgba(5,11,20,.76))!important; background-color:transparent!important; border-color:rgba(255,255,255,.12)!important; box-shadow:0 18px 50px rgba(0,0,0,.32),inset 0 1px 0 rgba(255,255,255,.08)!important; backdrop-filter:blur(28px) saturate(180%)!important; -webkit-backdrop-filter:blur(28px) saturate(180%)!important; }
    @media (max-width: 1023px) {
      html:not(.dark) #mainHeader #mobileMenuButton span { background: #0f172a !important; }
      .portfolio-mobile-copy { font-size: 11px; line-height: 1.65; }
    }
  </style>
  <style>html:not(#language-bg):not(#language-bg-override) #languageToggle,html:not(#language-bg):not(#language-bg-override) .language-toggle-btn,html:not(#language-bg):not(#language-bg-override) #languageToggle:hover,html:not(#language-bg):not(#language-bg-override) .language-toggle-btn:hover{background:transparent!important;background-color:transparent!important;background-image:none!important}</style>
</head>
<body class="bg-white text-slate-900 dark:bg-[#0a0a0a] dark:text-white font-sans antialiased selection:bg-brand-blue selection:text-white">

  <!-- Navbar -->
  <header class="fixed inset-x-0 top-0 z-50 transition-all duration-300" id="mainHeader">
    <nav class="mx-auto flex h-14 sm:h-16 w-full lg:px-[3.75%] items-center justify-between px-4 sm:px-6">

      <a href="/#home" class="flex items-center gap-3" aria-label="Apriprogram">
        <img src="/assets/logo/apriprogram.png" alt="Apriprogram Logo" class="h-5 sm:h-8 w-auto" />
        <span class="text-sm sm:text-lg font-medium tracking-tight text-slate-900 dark:text-white notranslate" translate="no">Apriprogram</span>
      </a>
      <div class="hidden items-center gap-8 text-sm font-normal text-slate-600 dark:text-slate-300 lg:flex">
        <a href="/#home" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <a href="/about" class="text-brand-blue font-semibold">Tentang</a>
        <a href="/#services" class="hover:text-slate-900 dark:hover:text-white transition-colors">Layanan</a>
        <a href="/portfolio" class="text-slate-900 dark:text-white hover:text-slate-900 dark:hover:text-white transition-colors">Portfolio</a>
        <a href="/#faq" class="hover:text-slate-900 dark:hover:text-white transition-colors notranslate" translate="no">FAQ</a>
        <a href="/#contact" class="hover:text-slate-900 dark:hover:text-white transition-colors">Kontak</a>
      </div>
      <div class="flex items-center gap-4">
                <!-- Language Switcher -->
        <button type="button" id="languageToggle" class="language-toggle-btn group relative inline-flex items-center gap-1.5 sm:gap-2 rounded-full border border-slate-300 dark:border-white/20 bg-transparent px-2.5 sm:px-3 py-1 sm:py-1.5 text-[10px] sm:text-xs font-normal text-slate-800 dark:text-white shadow-none transition-colors duration-200" aria-label="Ganti Bahasa" title="Ganti Bahasa (ID / EN)">
          <svg class="h-3 w-3 sm:h-3.5 sm:w-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
          </svg>
          <span class="lang-code inline-flex items-center justify-center font-normal text-[10px] sm:text-xs uppercase leading-none select-none">ID</span>
          <span class="lang-text hidden sm:inline font-medium tracking-wide">Indonesia</span>
          <svg class="h-3 w-3 shrink-0 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path>
          </svg>
        </button>

        <button id="darkModeToggle" class="p-1 sm:p-2 text-slate-500 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors" aria-label="Toggle Dark Mode">
          <svg id="moonIcon" class="w-4 h-4 sm:w-5 sm:h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          <svg id="sunIcon" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
        <div class="hidden items-center gap-3 lg:flex">
          <% if (user && user.userId) { %>
            <a href="<%= (user.role === 'admin' || user.role === 'super admin') ? '/admin/dashboard' : '/order' %>" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors">Dasbor</a>
            <a href="/logout" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors">Logout</a>
          <% } else { %>
            <a href="/login" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors">Login</a>
          <% } %>
        </div>
        <button id="mobileMenuButton" type="button" class="inline-flex p-1 sm:p-2 flex-col items-center justify-center gap-[3px] sm:gap-1.5 lg:hidden text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
        </button>
      </div>
    </nav>
    <!-- Mobile Menu -->
    <div id="mobileMenu" class="absolute top-[64px] sm:top-[72px] inset-x-4 z-40 flex flex-col bg-white dark:bg-[#0a0a0a] border border-slate-200 dark:border-white/10 p-5 sm:p-6 rounded-2xl shadow-2xl lg:hidden opacity-0 scale-95 pointer-events-none transition-all duration-300 origin-top">
      <div class="flex flex-col gap-4 text-sm font-medium text-slate-700 dark:text-slate-300">
            <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-white/10">
          <span class="text-sm font-medium text-slate-900 dark:text-slate-300 lang-mobile-label">Bahasa</span>
          <button type="button" class="language-toggle-btn inline-flex items-center gap-1.5 sm:gap-2 rounded-full border border-slate-300 dark:border-white/10 bg-transparent px-3 py-1.5 text-xs font-semibold text-slate-800 dark:text-white shadow-none transition-colors duration-200 hover:border-slate-400 dark:hover:border-white/40">
            <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
            </svg>
            <span class="lang-code inline-flex items-center justify-center font-bold text-xs uppercase leading-none select-none">ID</span>
            <span class="lang-text font-medium">Indonesia</span>
          </button>
        </div>

        <a href="/#home" class="hover:text-brand-blue dark:hover:text-white transition-colors">Home</a>
        <a href="/about" class="hover:text-brand-blue dark:hover:text-white transition-colors">Tentang</a>
        <a href="/#services" class="hover:text-brand-blue dark:hover:text-white transition-colors">Layanan</a>
        <a href="/portfolio" class="text-brand-blue font-semibold">Portfolio</a>
        <a href="/#faq" class="hover:text-brand-blue dark:hover:text-white transition-colors notranslate" translate="no">FAQ</a>
        <a href="/#contact" class="hover:text-brand-blue dark:hover:text-white transition-colors">Kontak</a>
        <div class="h-px w-full bg-slate-200 bg-transparent my-1"></div>
        <% if (user && user.userId) { %>
          <a href="<%= (user.role === 'admin' || user.role === 'super admin') ? '/admin/dashboard' : '/order' %>" class="hover:text-brand-blue dark:hover:text-white transition-colors">Dasbor</a>
          <a href="/logout" class="text-red-500 hover:text-red-600 transition-colors">Logout</a>
        <% } else { %>
          <a href="/login" class="hover:text-brand-blue dark:hover:text-white transition-colors">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="pt-14 sm:pt-16">

    <!-- HERO -->
    <section class="relative pt-3 pb-5 sm:pt-16 sm:pb-14 bg-white dark:bg-[#0a0a0a] border-b border-slate-200 dark:border-white/5 overflow-hidden">
      <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]" style="background-image: linear-gradient(rgba(36,60,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(36,60,255,1) 1px, transparent 1px); background-size: 50px 50px;"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[60vw] h-[40vh] bg-gradient-to-b from-brand-blue/20 to-transparent blur-3xl pointer-events-none"></div>
      <div class="relative z-10 mx-auto w-full lg:px-[3.75%] px-4 sm:px-6">
        <div class="flex flex-col md:flex-row gap-1 md:gap-10 lg:gap-20 justify-between items-start">
          <div class="reveal">
            <h1 class="text-xl sm:text-6xl lg:text-7xl font-normal tracking-tight text-slate-900 dark:text-white leading-[1.05]">
              Our projects<br><span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue to-brand-cyan">portfolio</span>
            </h1>
          </div>
          <div class="reveal max-w-md md:pt-6 md:text-right flex flex-col md:items-end">
            <p class="portfolio-mobile-copy mt-1 sm:mt-4 text-[11px] sm:text-lg text-slate-500 dark:text-[#a0a0a0] leading-relaxed">
              Lihat beberapa karya terbaik kami yang telah membantu berbagai bisnis mencapai tujuannya dengan solusi digital modern.
            </p>
            <div class="flex flex-row gap-2 sm:gap-3 w-full lg:w-fit mt-4 sm:mt-7 items-center md:justify-end">
              <a href="/#portfolio" class="flex-1 lg:flex-none inline-flex items-center justify-center gap-1.5 sm:gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 sm:px-5 sm:py-3 text-[11px] sm:text-sm font-semibold text-slate-700 transition-all hover:border-brand-blue hover:text-brand-blue dark:border-white/10 dark:bg-transparent dark:text-white dark:hover:border-brand-blue dark:hover:text-white">
                <svg class="h-3 w-3 sm:h-4 sm:w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>Kembali
              </a>
              <a href="/login?type=register" class="flex-1 lg:flex-none inline-flex items-center justify-center gap-1.5 sm:gap-2 rounded-full bg-brand-blue px-3 py-2 sm:px-6 sm:py-3 text-[11px] sm:text-sm font-semibold text-white transition-colors hover:bg-brand-blue/80 dark:bg-brand-blue/90 dark:hover:bg-brand-blue/70">
                Pesan Sekarang
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PORTFOLIO GRID -->
    <section class="pt-6 pb-20 sm:pt-14 sm:pb-20 bg-slate-50 dark:bg-[#0a0a0a]">
      <div class="mx-auto w-full px-4 sm:px-6 lg:px-[3.75%]">

        <!-- Category Filter -->
        <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
          <div class="reveal mb-4 sm:mb-10 flex flex-wrap gap-2 items-center justify-start sm:justify-center">
            <a href="/portfolio" class="px-3 py-1.5 sm:px-5 sm:py-2 rounded-full text-[11px] sm:text-sm font-medium border transition-all <%= !activeCategory ? 'bg-brand-blue text-white border-brand-blue' : 'bg-transparent text-slate-600 border-slate-300 hover:border-brand-blue hover:text-brand-blue dark:text-slate-300 dark:border-white/20 dark:hover:border-brand-blue dark:hover:text-white' %>">
              Semua Project
            </a>
            <% categories.forEach(category => { %>
              <a href="/portfolio?category=<%= encodeURIComponent(category) %>" class="px-3 py-1.5 sm:px-5 sm:py-2 rounded-full text-[11px] sm:text-sm font-medium border transition-all <%= activeCategory === category ? 'bg-brand-blue text-white border-brand-blue' : 'bg-transparent text-slate-600 border-slate-300 hover:border-brand-blue hover:text-brand-blue dark:text-slate-300 dark:border-white/20 dark:hover:border-brand-blue dark:hover:text-white' %>">
                <%= category %>
              </a>
            <% }) %>
          </div>
        <% } %>

        <% if (!projects || projects.length === 0) { %>
          <!-- Empty State -->
          <div class="flex flex-col items-center justify-center py-32 text-center">
            <div class="w-20 h-20 rounded-2xl bg-slate-100 bg-transparent flex items-center justify-center mb-6">
              <svg class="w-10 h-10 text-slate-400 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <h2 class="text-2xl font-semibold text-slate-700 dark:text-slate-300 mb-3">Belum ada portfolio</h2>
            <p class="text-sm text-slate-500 dark:text-[#a0a0a0] max-w-sm">Portfolio akan ditampilkan di sini setelah ditambahkan oleh admin.</p>
            <a href="/" class="mt-8 inline-flex items-center gap-1.5 sm:gap-2 rounded-full border border-slate-200 dark:border-white/10 px-5 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 hover:bg-transparent transition-all">Kembali ke Home</a>
          </div>
        <% } else { %>
          <!-- Project Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6" id="projectGrid">
            <% projects.forEach((project, index) => { %>
              <% const hasProjectImage = Boolean(project.image) && !/^https:\/\/images\.unsplash\.com\/photo-(1460925895917|1551288049|1522199755839|1517245386807)-/i.test(project.image); %>
              <article class="reveal project-card group relative rounded-xl sm:rounded-2xl overflow-hidden <%= hasProjectImage ? 'bg-transparent' : 'bg-slate-100 dark:bg-[#1a1a1a]' %> cursor-pointer">
                <a href="/portfolio/<%= encodeURIComponent(project.slug || '') %>" class="block w-full h-full relative aspect-[4/3]">
                  <!-- Image -->
                  <% if (hasProjectImage) { %>
                    <img src="<%= project.image %>" alt="<%= project.image_alt || project.title %>" class="card-image absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden')">
                  <% } %>
                    <div class="<%= hasProjectImage ? 'hidden ' : '' %>absolute inset-0 w-full h-full flex items-center justify-center bg-slate-100 dark:bg-[#1a1a1a] transition-transform duration-700 group-hover:scale-105">
                      <svg class="w-16 h-16 text-slate-400 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>

                  <!-- Gradient Overlay (Always present at the bottom, slightly darker on hover) -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

                  <!-- Content Area (Bottom aligned) -->
                  <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7 flex flex-col justify-end">
                    
                    <div class="flex items-end justify-between gap-4">
                      
                      <!-- Text Content -->
                      <div class="flex-1 transform translate-y-6 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 ease-out">
                        <!-- Title (Semibold & Smaller) -->
                        <h2 class="text-[13px] sm:text-base font-semibold text-white tracking-tight leading-tight"><%= project.title || 'Untitled Project' %></h2>
                        
                        <!-- Hover Details -->
                        <div class="grid grid-rows-[0fr] group-hover:grid-rows-[1fr] transition-all duration-500 ease-out opacity-0 group-hover:opacity-100">
                          <div class="overflow-hidden">
                            <div class="pt-2 sm:pt-3">
                              <!-- Description -->
                              <% if (project.short_description) { %>
                                <p class="text-[10px] sm:text-sm text-slate-300 leading-relaxed line-clamp-2 mb-3"><%= project.short_description %></p>
                              <% } %>

                              <!-- Tags -->
                              <div class="flex flex-wrap gap-2">
                                <% if (project.category) { %>
                                  <span class="inline-flex items-center rounded-full bg-white/20 px-2.5 py-1 text-[10px] sm:text-[11px] font-normal text-white"><%= project.category %></span>
                                <% } %>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      
                      <!-- Icon CTA (Visible on hover) -->
                      <div class="w-9 h-9 shrink-0 rounded-full bg-white flex items-center justify-center opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500 ease-out">
                        <svg class="card-arrow w-4 h-4 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M7 7h10v10"/></svg>
                      </div>

                    </div>
                  </div>

                </a>
              </article>
            <% }) %>
          </div>
          
          <% if (totalPages > 1) { %>
            <div class="mt-12 flex items-center justify-center gap-2">
