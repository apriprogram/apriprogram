<!DOCTYPE html>
<html lang="id" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio - Apriprogram</title>
  <meta name="description" content="Lihat beberapa karya terbaik Apriprogram yang telah membantu berbagai bisnis mencapai tujuannya dengan solusi digital modern.">
  <link rel="icon" href="/assets/logo/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Poppins', 'sans-serif'] },
          colors: { brand: { blue: '#243CFF', cyan: '#22D3EE', ink: '#050b14' } }
        }
      }
    };
  </script>
  <script id="apriprogram-theme-init">
    if (localStorage.theme === 'light') document.documentElement.classList.remove('dark');
    else document.documentElement.classList.add('dark');
  </script>
  <style>
    .reveal { opacity: 0; transform: translateY(32px); transition: opacity 0.7s cubic-bezier(.16,1,.3,1), transform 0.7s cubic-bezier(.16,1,.3,1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .project-card { transition: transform 0.4s ease, box-shadow 0.4s ease; }
    .project-card:hover .card-image { transform: scale(1.05); }
    .card-image { transition: transform 0.7s cubic-bezier(.16,1,.3,1); }
    .project-card:hover .card-overlay { opacity: 1; }
    .card-overlay { transition: opacity 0.4s ease; opacity: 0; }
    .project-card:hover .card-arrow { transform: translate(3px, -3px); }
    .card-arrow { transition: transform 0.3s ease; }
    .filter-btn { transition: all 0.3s ease; }
    .filter-btn.active { background: #243CFF; color: white; border-color: #243CFF; }
  </style>
</head>
<body class="bg-white text-slate-900 dark:bg-[#0a0a0a] dark:text-white font-sans antialiased selection:bg-brand-blue selection:text-white">

  <!-- Navbar -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200 bg-white/85 backdrop-blur-lg transition-all duration-300 dark:border-white/5 dark:bg-[#050b14]/80" id="mainHeader">
    <nav class="mx-auto flex h-16 max-w-[85%] items-center justify-between px-4 sm:px-6">
      <a href="/#home" class="flex items-center gap-3" aria-label="Apriprogram">
        <img src="/assets/logo/apriprogram.png" alt="Apriprogram Logo" class="h-6 sm:h-8 w-auto" />
        <span class="text-base sm:text-lg font-medium tracking-tight text-slate-900 dark:text-white">Apriprogram</span>
      </a>
      <div class="hidden items-center gap-8 text-sm font-semibold text-slate-600 dark:text-slate-300 lg:flex">
        <a href="/#home" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <a href="/#services" class="hover:text-slate-900 dark:hover:text-white transition-colors">Layanan</a>
        <a href="/portfolio" class="text-slate-900 dark:text-white hover:text-slate-900 dark:hover:text-white transition-colors">Portfolio</a>
        <a href="/#faq" class="hover:text-slate-900 dark:hover:text-white transition-colors">FAQ</a>
        <a href="/#contact" class="hover:text-slate-900 dark:hover:text-white transition-colors">Kontak</a>
      </div>
      <div class="flex items-center gap-4">
        <button id="darkModeToggle" class="p-1 sm:p-2 text-slate-500 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors" aria-label="Toggle Dark Mode">
          <svg id="moonIcon" class="w-4 h-4 sm:w-5 sm:h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          <svg id="sunIcon" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
        <div class="hidden items-center gap-3 lg:flex">
          <% if (user && user.userId) { %>
            <a href="<%= (user.role === 'admin' || user.role === 'super admin') ? '/admin/dashboard' : '/order' %>" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors">Dasbor</a>
            <a href="/logout" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors">Logout</a>
          <% } else { %>
            <a href="/login" class="text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors">Login</a>
          <% } %>
        </div>
        <button id="mobileMenuButton" type="button" class="inline-flex p-1 sm:p-2 flex-col items-center justify-center gap-[3px] sm:gap-1.5 lg:hidden text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
          <span class="h-[2px] w-4 sm:w-5 rounded bg-slate-900 dark:bg-white"></span>
        </button>
      </div>
    </nav>
    <!-- Mobile Menu -->
    <div id="mobileMenu" class="absolute top-[72px] inset-x-4 z-40 flex flex-col bg-white dark:bg-[#0a0a0a] border border-slate-200 dark:border-white/10 p-6 rounded-2xl shadow-2xl lg:hidden opacity-0 scale-95 pointer-events-none transition-all duration-300 origin-top">
      <div class="flex flex-col gap-4 text-sm font-medium text-slate-700 dark:text-slate-300">
        <a href="/#home" class="hover:text-brand-blue dark:hover:text-white transition-colors">Home</a>
        <a href="/#services" class="hover:text-brand-blue dark:hover:text-white transition-colors">Layanan</a>
        <a href="/portfolio" class="text-brand-blue font-semibold">Portfolio</a>
        <a href="/#faq" class="hover:text-brand-blue dark:hover:text-white transition-colors">FAQ</a>
        <a href="/#contact" class="hover:text-brand-blue dark:hover:text-white transition-colors">Kontak</a>
        <div class="h-px w-full bg-slate-200 dark:bg-white/10 my-1"></div>
        <% if (user && user.userId) { %>
          <a href="<%= (user.role === 'admin' || user.role === 'super admin') ? '/admin/dashboard' : '/order' %>" class="hover:text-brand-blue dark:hover:text-white transition-colors">Dasbor</a>
          <a href="/logout" class="text-red-500 hover:text-red-600 transition-colors">Logout</a>
        <% } else { %>
          <a href="/login" class="hover:text-brand-blue dark:hover:text-white transition-colors">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="pt-16">

    <!-- HERO -->
    <section class="relative py-20 sm:py-28 bg-white dark:bg-[#0a0a0a] border-b border-slate-200 dark:border-white/5 overflow-hidden">
      <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]" style="background-image: linear-gradient(rgba(36,60,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(36,60,255,1) 1px, transparent 1px); background-size: 50px 50px;"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[60vw] h-[40vh] bg-gradient-to-b from-brand-blue/20 to-transparent blur-3xl pointer-events-none"></div>
      <div class="relative z-10 mx-auto max-w-[85%] px-4 sm:px-6">
        <div class="flex flex-col md:flex-row gap-10 lg:gap-20 justify-between items-start">
          <div class="reveal">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-blue mb-4">Portfolio</p>
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-normal tracking-tight text-slate-900 dark:text-white leading-[1.05]">
              Our projects<br><span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue to-brand-cyan">portfolio</span>
            </h1>
          </div>
          <div class="reveal max-w-md pt-2 md:pt-6">
            <p class="text-base sm:text-lg text-slate-500 dark:text-[#a0a0a0] leading-relaxed">
              Lihat beberapa karya terbaik kami yang telah membantu berbagai bisnis mencapai tujuannya dengan solusi digital modern.
            </p>
            <a href="/#contact" class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand-blue px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-600 transition-all hover:-translate-y-0.5">
              Mulai Proyek
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- PORTFOLIO GRID -->
    <section class="py-20 bg-slate-50 dark:bg-[#0a0a0a]">
      <div class="mx-auto max-w-[85%] px-4 sm:px-6 lg:px-8">

        <% if (!projects || projects.length === 0) { %>
          <!-- Empty State -->
          <div class="flex flex-col items-center justify-center py-32 text-center">
            <div class="w-20 h-20 rounded-2xl bg-slate-100 dark:bg-white/5 flex items-center justify-center mb-6">
              <svg class="w-10 h-10 text-slate-400 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <h2 class="text-2xl font-semibold text-slate-700 dark:text-slate-300 mb-3">Belum ada portfolio</h2>
            <p class="text-sm text-slate-500 dark:text-[#a0a0a0] max-w-sm">Portfolio akan ditampilkan di sini setelah ditambahkan oleh admin.</p>
            <a href="/" class="mt-8 inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-white/10 px-5 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 transition-all">Kembali ke Home</a>
          </div>
        <% } else { %>
          <!-- Project Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="projectGrid">
            <% projects.forEach((project, index) => { %>
              <% const isLarge = index === 0; %>
              <article class="reveal project-card group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-white dark:bg-[#111] border border-slate-200 dark:border-white/5 cursor-pointer <%= isLarge ? 'md:col-span-2 lg:col-span-2' : '' %>">
                <a href="/portfolio/<%= encodeURIComponent(project.slug || '') %>" class="block">
                  <!-- Image -->
                  <div class="relative overflow-hidden <%= isLarge ? 'aspect-[16/9]' : 'aspect-[4/3]' %> bg-slate-100 dark:bg-[#1a1a1a]">
                    <% if (project.image) { %>
                      <img src="<%= project.image %>" alt="<%= project.image_alt || project.title %>" class="card-image w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80'">
                    <% } else { %>
                      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-200 to-slate-300 dark:from-[#1a1a1a] dark:to-[#2a2a2a]">
                        <svg class="w-16 h-16 text-slate-400 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      </div>
                    <% } %>
                    <!-- Gradient Overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                    <!-- Title on image -->
                    <div class="absolute bottom-5 left-5 sm:bottom-7 sm:left-7">
                      <h2 class="text-xl sm:text-<%= isLarge ? '3xl' : '2xl' %> font-semibold text-white tracking-tight leading-tight"><%= project.title || 'Untitled Project' %></h2>
                    </div>
                    <!-- Hover overlay -->
                    <div class="card-overlay absolute inset-0 bg-brand-blue/20 flex items-center justify-center">
                      <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center">
                        <svg class="card-arrow w-5 h-5 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M7 7h10v10"/></svg>
                      </div>
                    </div>
                  </div>
                  <!-- Card Body -->
                  <div class="p-5 sm:p-6 flex flex-col gap-3">
                    <div class="flex items-center justify-between gap-4">
                      <div class="flex flex-wrap gap-2">
                        <% if (project.category) { %>
                          <span class="inline-flex items-center rounded-full bg-brand-blue/8 dark:bg-brand-blue/15 px-3 py-1 text-xs font-medium text-brand-blue"><%= project.category %></span>
                        <% } %>
                        <% if (project.tech_stack) { %>
                          <span class="inline-flex items-center rounded-full bg-slate-100 dark:bg-white/5 px-3 py-1 text-xs font-medium text-slate-500 dark:text-[#a0a0a0]"><%= project.tech_stack %></span>
                        <% } %>
                      </div>
                      <span class="flex-shrink-0 inline-flex items-center gap-1 text-xs font-medium text-brand-blue group-hover:gap-2 transition-all">
                        Lihat detail
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                      </span>
                    </div>
                    <% if (project.short_description) { %>
                      <p class="text-sm text-slate-500 dark:text-[#a0a0a0] leading-relaxed line-clamp-2"><%= project.short_description %></p>
                    <% } %>
                  </div>
                </a>
              </article>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

    <!-- CTA SECTION -->
    <section class="py-24 bg-white dark:bg-[#060606] border-t border-slate-200 dark:border-white/5">
      <div class="mx-auto max-w-[85%] px-4 sm:px-6 lg:px-8">
        <div class="reveal rounded-3xl bg-gradient-to-br from-brand-blue via-[#1e30cc] to-[#1a2aaa] p-10 sm:p-16 text-center relative overflow-hidden">
          <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 28px 28px;"></div>
          <div class="relative z-10">
            <h2 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-normal text-white tracking-tight leading-[1.05] mb-5">
              Siap memulai<br>proyek Anda?
            </h2>
            <p class="text-base sm:text-lg text-blue-100 max-w-xl mx-auto leading-relaxed mb-10">
              Konsultasikan kebutuhan digital Anda bersama kami. Kami siap merancang solusi terbaik yang sesuai dengan target dan anggaran bisnis Anda.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="https://wa.me/6282181361433?text=Halo%2C%20saya%20tertarik%20untuk%20membuat%20project%20bersama%20Apriprogram" target="_blank" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-brand-blue hover:bg-blue-50 transition-all hover:-translate-y-0.5">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Hubungi via WhatsApp
              </a>
              <a href="/services" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-6 py-3.5 text-sm font-semibold text-white hover:bg-white/10 transition-all hover:-translate-y-0.5">
                Lihat Layanan
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-200 dark:border-white/5 bg-white dark:bg-[#0a0a0a] py-14">
    <div class="mx-auto flex flex-col items-center text-center gap-5 max-w-lg px-4 sm:px-6">
      <a href="/#home" class="flex items-center justify-center gap-2 sm:gap-3">
        <img src="/assets/logo/apriprogram.png" alt="Apriprogram Logo" class="h-7 w-auto" />
        <span class="text-lg font-medium tracking-tight text-slate-900 dark:text-white">Apriprogram</span>
      </a>
      <p class="text-sm leading-relaxed text-slate-500 dark:text-[#a0a0a0]">
        Membantu perusahaan, agensi, dan startup menciptakan ekosistem digital terbaik.
      </p>
    </div>
    <div class="mx-auto mt-10 max-w-[85%] px-4 text-sm text-slate-400 dark:text-[#a0a0a0] sm:px-6 border-t border-slate-200 dark:border-white/5 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p>2026 &copy; Apriprogram. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-slate-900 dark:hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-slate-900 dark:hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </footer>

  <script>
    // Theme
    const html = document.documentElement;
    const toggleBtn = document.getElementById('darkModeToggle');
    const moonIcon = document.getElementById('moonIcon');
    const sunIcon = document.getElementById('sunIcon');
    const applyThemeIcons = () => {
      if (!moonIcon || !sunIcon) return;
      if (html.classList.contains('dark')) { moonIcon.classList.add('hidden'); sunIcon.classList.remove('hidden'); }
      else { sunIcon.classList.add('hidden'); moonIcon.classList.remove('hidden'); }
    };
    if (localStorage.theme === 'light') html.classList.remove('dark');
    else html.classList.add('dark');
    applyThemeIcons();
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        html.classList.toggle('dark');
        localStorage.theme = html.classList.contains('dark') ? 'dark' : 'light';
        applyThemeIcons();
      });
    }

    // Mobile menu
    const mobileMenuButton = document.getElementById('mobileMenuButton');
    const mobileMenu = document.getElementById('mobileMenu');
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('opacity-0'); mobileMenu.classList.toggle('scale-95'); mobileMenu.classList.toggle('pointer-events-none');
        mobileMenu.classList.toggle('opacity-100'); mobileMenu.classList.toggle('scale-100'); mobileMenu.classList.toggle('pointer-events-auto');
      });
      mobileMenu.querySelectorAll('a').forEach(l => l.addEventListener('click', () => {
        mobileMenu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
        mobileMenu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      }));
    }

    // Reveal
    const revealObs = new IntersectionObserver((entries) => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add('visible'), Number(e.target.dataset.delay || 0));
          revealObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el, i) => {
      el.dataset.delay = (i % 4) * 80;
      revealObs.observe(el);
    });

    // Header shadow on scroll
    window.addEventListener('scroll', () => {
      document.getElementById('mainHeader').classList.toggle('shadow-sm', window.scrollY > 60);
    });
  </script>
</body>
</html>
