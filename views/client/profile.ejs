<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Profil - Apriprogram</title>
  <meta name="description" content="Edit informasi profil akun Anda di Apriprogram.">
  <link rel="icon" href="/assets/logo/favicon.png" type="image/png">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script>
    if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          fontFamily: { sans: ['Poppins', 'sans-serif'] },
          colors: { brand: { blue: "#243CFF", cyan: "#22D3EE" } }
        }
      }
    };
  </script>
  <style>
    body {
      background-color: #efefef;
      background-image: radial-gradient(circle, rgba(148, 163, 184, 0.22) 1px, transparent 1px);
      background-size: 24px 24px;
    }
    html.dark body {
      background-color: #050b14;
      background-image: radial-gradient(circle, rgba(148, 163, 184, 0.12) 1px, transparent 1px);
    }
    .avatar-preview-wrap { position: relative; display: inline-block; }
    .avatar-overlay {
      position: absolute; inset: 0; border-radius: 9999px;
      background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.2s; cursor: pointer;
    }
    .avatar-preview-wrap:hover .avatar-overlay { opacity: 1; }
    .input-field {
      width: 100%; padding: 0.625rem 0.875rem; border-radius: 0.75rem; font-size: 0.875rem; outline: none;
      border: 1.5px solid #e2e8f0; background: #fff; color: #1e293b;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .input-field:focus { border-color: #243CFF; box-shadow: 0 0 0 3px rgba(36,60,255,0.12); }
    html.dark .input-field { background: #0f1929; border-color: rgba(255,255,255,0.1); color: #e2e8f0; }
    html.dark .input-field:focus { border-color: #5b7cfa; box-shadow: 0 0 0 3px rgba(91,124,250,0.18); }
    .card {
      background: rgba(255,255,255,0.85); border: 1px solid rgba(226,232,240,0.8);
      border-radius: 1.25rem; backdrop-filter: blur(12px);
    }
    html.dark .card {
      background: rgba(10,20,40,0.75); border-color: rgba(255,255,255,0.07);
    }
    #toast {
      position: fixed; top: 1.5rem; left: 50%; transform: translateX(-50%) translateY(-80px);
      z-index: 9999; transition: transform 0.35s cubic-bezier(.34,1.56,.64,1);
      white-space: nowrap; pointer-events: none;
    }
    #toast.show { transform: translateX(-50%) translateY(0); }
  </style>

  <style>
    .dropdown-open {
      opacity: 1 !important;
      transform: scale(1) !important;
      pointer-events: auto !important;
    }
  </style>
</head>
<body class="text-slate-900 dark:text-white min-h-screen flex flex-col">
  <div id="google_translate_element" class="hidden"></div>

  <!-- Toast -->
  <div id="toast" class="flex items-center gap-2 px-5 py-3 rounded-full text-sm font-semibold shadow-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-white border border-slate-200 dark:border-white/10">
    <span id="toastIcon"></span>
    <span id="toastMsg"></span>
  </div>
  <!-- Header -->
  <header class="fixed left-1/2 top-3 z-50 w-[calc(100%-1.25rem)] max-w-2xl -translate-x-1/2 sm:top-4 sm:w-[calc(100%-2rem)]">
    <nav id="mainNav" class="relative flex items-center justify-between rounded-full border border-white/70 bg-[#efefef]/75 px-1.5 py-1.5 text-slate-700 shadow-[0_8px_24px_rgba(15,23,42,0.06)] backdrop-blur-2xl dark:border-white/10 dark:bg-slate-900/55 dark:text-slate-200 dark:shadow-[0_8px_24px_rgba(0,0,0,0.18)] sm:px-2 sm:py-2">
      <a href="/order?view=home" class="relative z-10 flex h-9 items-center gap-1.5 rounded-full px-3 text-xs font-semibold sm:h-11 sm:gap-2 sm:px-4 sm:text-sm text-slate-600 transition-colors duration-300 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white shrink-0" aria-label="Home">
        <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9z"></path></svg>
        <span class="hidden sm:inline">Home</span>
      </a>
      <a href="/order" class="relative z-10 flex h-9 items-center gap-1.5 rounded-full px-3 text-xs font-semibold sm:h-11 sm:gap-2 sm:px-4 sm:text-sm text-slate-600 transition-colors duration-300 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white" aria-label="Form Pemesanan">
        <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5h6m-7 4h8m-8 4h5m-7 8h12a2 2 0 002-2V7.5L15.5 3H6a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        <span class="hidden sm:inline">Form Pemesanan</span>
      </a>
      <a href="/order?view=flow" class="relative z-10 flex h-9 items-center gap-1.5 rounded-full px-3 text-xs font-semibold sm:h-11 sm:gap-2 sm:px-4 sm:text-sm text-slate-600 transition-colors duration-300 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white" aria-label="Alur">
        <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h6m4 0h6M4 12h10m4 0h2M4 18h4m4 0h8"></path></svg>
        <span class="hidden sm:inline">Alur</span>
      </a>
      <button type="button" id="languageToggle" class="relative z-10 flex h-9 w-9 items-center justify-center rounded-full text-slate-600 sm:h-11 sm:w-11 transition-colors hover:bg-white/60 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white dark:focus:ring-white/20" aria-label="Ganti Bahasa" title="Ganti bahasa">
        <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 015.412 9m6.176 0A18.023 18.023 0 017 16m8-5h6m-3-3v3m0 0v3m0-3h3m-3 0h-3"></path></svg>
      </button>
      <button id="themeToggle" class="relative z-10 flex h-9 w-9 items-center justify-center rounded-full text-slate-600 sm:h-11 sm:w-11 transition-colors hover:bg-white/60 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white dark:focus:ring-white/20" aria-label="Toggle Dark Mode">
        <svg id="themeIconDark" class="h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        <svg id="themeIconLight" class="h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
      </button>
      <a href="/logout" class="relative z-10 hidden h-9 w-9 items-center justify-center rounded-full text-slate-600 sm:h-11 sm:w-11 transition-colors hover:bg-white/60 hover:text-red-500 lg:flex dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-red-400" title="Logout <%= user.email %>" aria-label="Logout">
        <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H9m4 8H6a2 2 0 01-2-2V6a2 2 0 012-2h7"></path></svg>
      </a>
      <!-- Profile Dropdown (Mobile) -->
      <div class="relative z-20 flex items-center gap-3 text-right text-slate-900 dark:text-white lg:hidden" id="profileDropdownWrapperMobile">
        <div class="relative" id="profileDropdownContainerMobile">
          <button id="profileAvatarBtnMobile" type="button" aria-haspopup="true" aria-expanded="false" class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white text-xs font-semibold text-slate-900 ring-1 ring-slate-200 transition-all duration-200 hover:ring-2 hover:ring-blue-500 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-white dark:text-slate-900 dark:ring-white/20 dark:hover:ring-blue-400 cursor-pointer select-none" title="Profil Saya">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" alt="Foto profil" class="h-full w-full object-cover">
            <% } else { %>
              <%= (user.full_name || (user.email ? user.email.split('@')[0] : 'U')).trim().charAt(0).toUpperCase() %>
            <% } %>
          </button>
          <div id="profileDropdownMenuMobile" role="menu" aria-labelledby="profileAvatarBtnMobile" class="absolute right-0 mt-2 w-52 origin-top-right rounded-2xl border border-slate-200/80 bg-white/90 px-2 py-2 opacity-0 scale-95 pointer-events-none shadow-xl backdrop-blur-xl transition-all duration-200 ease-out dark:border-white/10 dark:bg-slate-900/90 dark:shadow-[0_8px_32px_rgba(0,0,0,0.4)]" style="top: calc(100% + 8px);">
            <a href="/client/profile" role="menuitem" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-blue-50 hover:text-blue-700 dark:text-slate-200 dark:hover:bg-blue-500/15 dark:hover:text-blue-300 group">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 transition-colors duration-150 group-hover:text-blue-700 dark:text-slate-300 dark:group-hover:text-blue-300">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
              </span>
              Edit Profil
            </a>
            <a href="/bantuan" role="menuitem" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-amber-50 hover:text-amber-700 dark:text-slate-200 dark:hover:bg-amber-500/15 dark:hover:text-amber-300 group">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 transition-colors duration-150 group-hover:text-amber-700 dark:text-slate-300 dark:group-hover:text-amber-300">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </span>
              Bantuan
            </a>
            <a href="/logout" role="menuitem" class="mt-2 flex items-center gap-3 rounded-xl border-t border-slate-200/80 px-3 py-2.5 pt-3 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-red-50 hover:text-red-600 dark:border-white/10 dark:text-slate-200 dark:hover:bg-red-500/15 dark:hover:text-red-400 group">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 transition-colors duration-150 group-hover:text-red-600 dark:text-slate-300 dark:group-hover:text-red-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H9m4 8H6a2 2 0 01-2-2V6a2 2 0 012-2h7"></path></svg>
              </span>
              Keluar
            </a>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <div class="fixed left-4 top-4 z-40 hidden max-w-sm items-center gap-4 text-slate-900 dark:text-white lg:flex">
    <img src="/assets/logo/apriprogram.png" alt="Apriprogram" class="h-9 w-auto shrink-0" onerror="this.style.display='none'">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-slate-950 dark:text-white">Edit Profil</p>
      <p class="mt-0.5 text-xs leading-snug text-slate-500 dark:text-slate-400">Perbarui informasi akun dan foto profil Anda.</p>
    </div>
  </div>

  <div class="fixed right-3 top-[1.05rem] z-[60] hidden lg:flex items-center gap-3 text-right text-slate-900 dark:text-white sm:top-[1.15rem] lg:right-4 lg:top-4 lg:z-40" id="profileDropdownWrapper">
    <div class="hidden min-w-0 lg:block">
      <p class="max-w-56 truncate text-sm font-semibold text-slate-950 dark:text-white"><%= user.full_name || (user.email ? user.email.split('@')[0] : 'User') %></p>
      <p class="max-w-56 truncate text-xs text-slate-500 dark:text-slate-400"><%= user.email %></p>
    </div>
    <div class="relative" id="profileDropdownContainer">
      <button id="profileAvatarBtn" type="button" aria-haspopup="true" aria-expanded="false" class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white text-xs font-semibold lg:h-11 lg:w-11 lg:text-sm text-slate-900 ring-1 ring-slate-200 transition-all duration-200 hover:scale-105 hover:ring-2 hover:ring-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-white dark:text-slate-900 dark:ring-white/20 dark:hover:ring-blue-400" title="Profil Saya">
        <% if (user.avatar) { %>
          <img src="<%= user.avatar %>" alt="Foto profil" class="h-full w-full object-cover">
        <% } else { %>
          <%= (user.full_name || (user.email ? user.email.split('@')[0] : 'U')).trim().charAt(0).toUpperCase() %>
        <% } %>
      </button>
      <div id="profileDropdownMenu" role="menu" aria-labelledby="profileAvatarBtn" class="absolute right-0 mt-2 w-52 origin-top-right rounded-2xl border border-slate-200/80 bg-white/90 px-2 py-2 opacity-0 scale-95 pointer-events-none shadow-xl backdrop-blur-xl transition-all duration-200 ease-out dark:border-white/10 dark:bg-slate-900/90 dark:shadow-[0_8px_32px_rgba(0,0,0,0.4)]" style="top: calc(100% + 8px);">
        <a href="/client/profile" role="menuitem" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-blue-50 hover:text-blue-700 dark:text-slate-200 dark:hover:bg-blue-500/15 dark:hover:text-blue-300 group">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 transition-colors duration-150 group-hover:text-blue-700 dark:text-slate-300 dark:group-hover:text-blue-300">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
          </span>
          Edit Profil
        </a>
        <a href="/bantuan" role="menuitem" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-amber-50 hover:text-amber-700 dark:text-slate-200 dark:hover:bg-amber-500/15 dark:hover:text-amber-300 group">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 transition-colors duration-150 group-hover:text-amber-700 dark:text-slate-300 dark:group-hover:text-amber-300">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </span>
          Bantuan
        </a>
        <a href="/logout" role="menuitem" class="mt-2 flex items-center gap-3 rounded-xl border-t border-slate-200/80 px-3 py-2.5 pt-3 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-red-50 hover:text-red-600 dark:border-white/10 dark:text-slate-200 dark:hover:bg-red-500/15 dark:hover:text-red-400 group">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center text-slate-500 transition-colors duration-150 group-hover:text-red-600 dark:text-slate-300 dark:group-hover:text-red-400">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H9m4 8H6a2 2 0 01-2-2V6a2 2 0 012-2h7"></path></svg>
          </span>
          Keluar
        </a>
      </div>
    </div>
  </div>
<main class="flex-grow pt-24 pb-16 lg:pt-28">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
      <h1 class="text-lg font-bold text-slate-900 dark:text-white mb-1 sm:text-2xl">Edit Profil</h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6 sm:mb-8">Perbarui informasi akun dan foto profil Anda.</p>

      <!-- Avatar Section -->
      <div class="mb-8 sm:mb-10 flex flex-col items-center text-center">
        <input type="file" id="avatarInput" accept="image/*" class="hidden">
        <div class="avatar-preview-wrap" id="avatarWrap">
          <div id="avatarPreview" class="h-24 w-24 sm:h-36 sm:w-36 rounded-full overflow-hidden bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-3xl sm:text-5xl font-bold text-white ring-4 ring-white dark:ring-slate-800 shadow-2xl">
            <% if (user.avatar) { %>
              <img id="avatarImg" src="<%= user.avatar %>" alt="Foto profil" class="h-full w-full object-cover">
            <% } else { %>
              <span id="avatarInitial"><%= (user.full_name || (user.email ? user.email.split('@')[0] : 'U')).trim().charAt(0).toUpperCase() %></span>
            <% } %>
          </div>
          <label for="avatarInput" class="avatar-overlay rounded-full" title="Ganti foto">
            <svg class="h-9 w-9 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </label>
          <button type="button" id="avatarDeleteBtn" class="absolute bottom-0 right-0 sm:bottom-2 sm:right-2 z-10 flex h-7 w-7 sm:h-10 sm:w-10 items-center justify-center rounded-full border border-white/80 bg-red-500 text-white shadow-lg transition hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-300 <%= user.avatar ? '' : 'hidden' %>" title="Hapus foto profil" aria-label="Hapus foto profil">
            <svg class="h-3.5 w-3.5 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m-7 0a1 1 0 001-1V5a1 1 0 011-1h4a1 1 0 011 1v1a1 1 0 001 1m-8 0h8"></path></svg>
          </button>
        </div>
        <p class="mt-4 text-xs text-slate-400 dark:text-slate-500">JPG, PNG, WebP, GIF. Maks 2MB.</p>
        <p id="avatarStatus" class="mt-1 text-xs text-blue-500 dark:text-blue-400 hidden">Mengupload...</p>
      </div>

      <!-- Profile Form -->
      <form id="profileForm" class="card p-4 sm:p-6 md:p-8 shadow-sm space-y-5 sm:space-y-6">
        <h2 class="text-xs sm:text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Informasi Akun</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="fullName" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Nama Lengkap</label>
            <input type="text" id="fullName" name="full_name" value="<%= user.full_name || '' %>" placeholder="Nama lengkap Anda" class="input-field" autocomplete="name">
          </div>
          <div>
            <label for="emailField" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Email</label>
            <input type="email" id="emailField" name="email" value="<%= user.email || '' %>" placeholder="email@contoh.com" class="input-field opacity-60 cursor-not-allowed" readonly>
            <p class="mt-1 text-xs text-slate-400">Email tidak dapat diubah.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="whatsapp" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Nomor WhatsApp</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400 dark:text-slate-500">+62</span>
              <input type="tel" id="whatsapp" name="whatsapp" value="<%= (user.whatsapp || '').replace(/^(\+62|62|0)/, '') %>" placeholder="812xxxxx" class="input-field pl-12" autocomplete="tel">
            </div>
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Instansi / Perusahaan <span class="text-slate-400 font-normal">(opsional)</span></label>
            <input type="text" id="company" name="company" value="<%= user.company || '' %>" placeholder="Nama instansi Anda" class="input-field" autocomplete="organization">
          </div>
        </div>

        <div>
          <label for="country" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Alamat <span class="text-slate-400 font-normal">(opsional)</span></label>
          <input type="text" id="country" name="country" value="<%= user.country || '' %>" placeholder="Masukkan alamat lengkap Anda" class="input-field" autocomplete="street-address">
        </div>

        <!-- Divider -->
        <div class="border-t border-slate-100 dark:border-white/10 pt-4">
          <h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-4">Ganti Password</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="newPassword" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Password Baru</label>
              <input type="password" id="newPassword" name="new_password" placeholder="Kosongkan jika tidak ingin ubah" class="input-field" autocomplete="new-password">
            </div>
            <div>
              <label for="confirmPassword" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">Konfirmasi Password</label>
              <input type="password" id="confirmPassword" name="confirm_password" placeholder="Ulangi password baru" class="input-field" autocomplete="new-password">
            </div>
          </div>
        </div>

        <!-- Submit -->
        <div class="flex items-center justify-end gap-2 sm:gap-3 pt-2">
          <a href="/order" class="px-4 py-1.5 sm:px-5 sm:py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-white/10 hover:bg-slate-200 dark:hover:bg-white/15 transition-colors">
            Batal
          </a>
          <button type="submit" id="saveBtn" class="flex items-center gap-1.5 sm:gap-2 px-4 py-1.5 sm:px-6 sm:py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-blue-600 hover:bg-blue-700 active:scale-95 text-white transition-all shadow-md shadow-blue-500/20">
            <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Simpan Perubahan
          </button>
        </div>
      </form>

      <!-- Danger Zone -->
      <div class="mt-4 sm:mt-6 card p-4 sm:p-6 md:p-8 shadow-sm border border-red-200/60 dark:border-red-900/30">
        <h2 class="text-xs sm:text-sm font-semibold text-red-500 uppercase tracking-wider mb-2">Zona Bahaya</h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-4">Tindakan berikut bersifat permanen dan tidak dapat dibatalkan.</p>
        <a href="/logout" class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold text-red-600 dark:text-red-400 border border-red-200 dark:border-red-900/50 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors">
          <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H9m4 8H6a2 2 0 01-2-2V6a2 2 0 012-2h7"/>
          </svg>
          Keluar dari Akun
        </a>
      </div>
    </div>
  </main>

  <script>

    // Profile dropdown
    (function () {
      function setupDropdown(btnId, menuId, containerId) {
        const btn = document.getElementById(btnId);
        const menu = document.getElementById(menuId);
        const container = document.getElementById(containerId);
        if (!btn || !menu || !container) return;
        
        let isOpen = false;
        function openDropdown() {
          isOpen = true;
          menu.classList.add('dropdown-open');
          btn.setAttribute('aria-expanded', 'true');
        }
        function closeDropdown() {
          isOpen = false;
          menu.classList.remove('dropdown-open');
          btn.setAttribute('aria-expanded', 'false');
        }
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          isOpen ? closeDropdown() : openDropdown();
        });
        document.addEventListener('click', function (e) {
          if (!container.contains(e.target)) closeDropdown();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && isOpen) closeDropdown();
        });
      }
      setupDropdown('profileAvatarBtn', 'profileDropdownMenu', 'profileDropdownContainer');
      setupDropdown('profileAvatarBtnMobile', 'profileDropdownMenuMobile', 'profileDropdownContainerMobile');
    })();

    // Language toggle
    function setTranslateCookie(language) {
      const value = language === 'en' ? '/id/en' : '/id/id';
      document.cookie = `googtrans=${value};path=/`;
      document.cookie = `googtrans=${value};domain=${location.hostname};path=/`;
    }

    function switchLanguage() {
      const isEnglish = document.cookie.includes('googtrans=/id/en');
      const nextLanguage = isEnglish ? 'id' : 'en';
      const select = document.querySelector('.goog-te-combo');
      if (select) {
        select.value = nextLanguage;
        select.dispatchEvent(new Event('change'));
      } else {
        setTranslateCookie(nextLanguage);
        window.location.reload();
      }
    }

    const languageToggle = document.getElementById('languageToggle');
    if (languageToggle) languageToggle.addEventListener('click', switchLanguage);
    // Theme toggle
    (function () {
      const html = document.documentElement;
      const btn = document.getElementById('themeToggle');
      const iconDark = document.getElementById('themeIconDark');
      const iconLight = document.getElementById('themeIconLight');

      function applyTheme() {
        const isDark = html.classList.contains('dark');
        iconDark.classList.toggle('hidden', !isDark);
        iconLight.classList.toggle('hidden', isDark);
      }
      applyTheme();

      btn.addEventListener('click', () => {
        html.classList.toggle('dark');
        localStorage.theme = html.classList.contains('dark') ? 'dark' : 'light';
        applyTheme();
      });
    })();

    // Toast
    function showToast(msg, success = true) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');
      toastMsg.textContent = msg;
      toastIcon.innerHTML = success
        ? '<svg class="h-4 w-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>'
        : '<svg class="h-4 w-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>';
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3200);
    }

    // Avatar preview & upload
    function renderAvatarInitial() {
      const preview = document.getElementById('avatarPreview');
      const fullName = document.getElementById('fullName')?.value.trim();
      const email = '<%= user.email || '' %>';
      const initial = (fullName || (email ? email.split('@')[0] : 'U')).trim().charAt(0).toUpperCase() || 'U';
      preview.innerHTML = `<span id="avatarInitial">${initial}</span>`;
    }

    const avatarDeleteBtn = document.getElementById('avatarDeleteBtn');
    if (avatarDeleteBtn) {
      avatarDeleteBtn.addEventListener('click', async function (event) {
        event.preventDefault();
        event.stopPropagation();
        const status = document.getElementById('avatarStatus');
        status.textContent = 'Menghapus foto...';
        status.className = 'mt-1 text-xs text-blue-500 dark:text-blue-400';
        try {
          const res = await fetch('/api/client/profile', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ avatar: null })
          });
          const data = await res.json();
          if (data.success) {
            renderAvatarInitial();
            avatarDeleteBtn.classList.add('hidden');
            status.textContent = 'Foto profil berhasil dihapus';
            status.className = 'mt-1 text-xs text-green-500';
          } else {
            status.textContent = data.message || 'Gagal menghapus foto';
            status.className = 'mt-1 text-xs text-red-500';
          }
        } catch (error) {
          status.textContent = 'Gagal menghapus foto.';
          status.className = 'mt-1 text-xs text-red-500';
        }
      });
    }

    document.getElementById('avatarInput').addEventListener('change', async function () {
      const file = this.files[0];
      if (!file) return;

      // Preview
      const reader = new FileReader();
      reader.onload = (e) => {
        const preview = document.getElementById('avatarPreview');
        preview.innerHTML = `<img id="avatarImg" src="${e.target.result}" alt="Foto profil" class="h-full w-full object-cover">`;
      };
      reader.readAsDataURL(file);

      // Upload
      const status = document.getElementById('avatarStatus');
      status.classList.remove('hidden');
      status.textContent = 'Mengupload...';

      const formData = new FormData();
      formData.append('avatar', file);

      try {
        const res = await fetch('/api/upload/avatar', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success) {
          status.textContent = 'Foto berhasil diupload';
          status.className = 'mt-1 text-xs text-green-500';
          // Update session avatar via profile update
          await fetch('/api/client/profile', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ avatar: data.url })
          });
        } else {
          status.textContent = data.message || 'Upload gagal';
          status.className = 'mt-1 text-xs text-red-500';
        }
      } catch (err) {
        status.textContent = 'Gagal mengunggah foto.';
        status.className = 'mt-1 text-xs text-red-500';
      }
      status.classList.remove('hidden');
    });

    // Profile form submit
    document.getElementById('profileForm').addEventListener('submit', async function (e) {
      e.preventDefault();
      const btn = document.getElementById('saveBtn');
      btn.disabled = true;
      btn.innerHTML = '<svg class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path></svg> Menyimpan...';

      const newPw = document.getElementById('newPassword').value;
      const confirmPw = document.getElementById('confirmPassword').value;

      if (newPw && newPw !== confirmPw) {
        showToast('Password baru tidak cocok!', false);
        btn.disabled = false;
        btn.innerHTML = '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Simpan Perubahan';
        return;
      }

      const rawWa = document.getElementById('whatsapp').value.trim();
      const wa = rawWa ? '62' + rawWa.replace(/^0/, '') : '';

      const payload = {
        full_name: document.getElementById('fullName').value.trim(),
        whatsapp: wa,
        company: document.getElementById('company').value.trim(),
        country: document.getElementById('country').value.trim(),
      };
      if (newPw) payload.new_password = newPw;

      try {
        const res = await fetch('/api/client/profile', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          showToast('Profil berhasil disimpan!', true);
          // Update avatar initial if name changed
          const nameFirst = payload.full_name.charAt(0).toUpperCase();
          const initial = document.getElementById('avatarInitial');
          if (initial) initial.textContent = nameFirst;
        } else {
          showToast(data.message || 'Gagal menyimpan.', false);
        }
      } catch (err) {
        showToast('Terjadi kesalahan server.', false);
      }

      btn.disabled = false;
      btn.innerHTML = '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Simpan Perubahan';
    });
  </script>

  <script>
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({ pageLanguage: 'id', includedLanguages: 'id,en', autoDisplay: false }, 'google_translate_element');
    }
  </script>
  <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</body>
</html>
