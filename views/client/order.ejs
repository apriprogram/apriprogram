    ];

    function renderPricing(type) {
      const grid = document.getElementById('packagesGrid');
      grid.innerHTML = '';
      const packages = pricingData[type] || defaultPricing;
      
      // Dinamis grid: jika hanya 2 paket, pakai 2 kolom di tengah agar tidak ada ruang kosong
      if (packages.length === 2) {
        grid.className = "grid grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto gap-4 w-full";
      } else {
        grid.className = "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4";
      }
      
      packages.forEach(pkg => {
        const isPopular = pkg.isPopular;
        const cardClass = isPopular 
          ? 'package-card border border-slate-200/60 bg-gradient-to-b from-white via-white to-[#fff7fb] dark:from-[#111111] dark:via-[#111111] dark:to-[#17111a] rounded-[1.35rem] p-6 sm:p-8 cursor-pointer relative transition-colors hover:border-slate-300 dark:hover:border-white/20'
          : 'package-card border border-slate-200/60 bg-white dark:bg-[#111111] rounded-[1.35rem] p-6 sm:p-8 cursor-pointer relative transition-colors hover:border-slate-300 dark:hover:border-white/20';
        
        const badgeHTML = isPopular ? `<span class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-r from-amber-300 via-yellow-200 to-amber-400 px-3 py-1 text-[11px] font-semibold text-amber-950 ring-2 ring-white dark:ring-[#111111]">Most popular</span>` : '';
        const btnClass = isPopular ? 'bg-slate-950 text-white w-full py-3 rounded-xl text-sm font-semibold mt-6 mb-8 hover:bg-slate-800 transition-colors dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200' : 'bg-white border border-slate-200 text-slate-900 w-full py-3 rounded-xl text-sm font-semibold mt-6 mb-8 hover:border-slate-300 hover:bg-slate-50 transition-colors dark:bg-transparent dark:border-white/15 dark:text-white dark:hover:bg-white/5';
        
        const featuresHTML = pkg.features.map(f => `
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">${f}</span>
          </li>
        `).join('');

        const html = `
          <div class="${cardClass}" data-pkg="${pkg.name}" data-price="${pkg.price}">
            ${badgeHTML}
            <div class="min-h-[11.25rem] pt-4">
              <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-2">${pkg.name}</h3>
              <p class="text-sm text-slate-500 dark:text-[#a0a0a0] leading-relaxed">${pkg.target}</p>
            </div>
            <div class="flex min-h-[3.25rem] items-end text-[2rem] xl:text-[2.15rem] font-semibold tracking-tight text-slate-950 dark:text-white mb-2 whitespace-nowrap">${pkg.price}</div>
            
            <button type="button" class="select-pkg-btn ${btnClass}">Pilih Paket</button>
            
            <div class="border-t border-slate-200/80 dark:border-white/10 mb-8"></div>
            <ul class="space-y-4 mb-8">
              ${featuresHTML}
            </ul>
            <div class="flex items-start gap-3 mt-auto pt-6 border-t border-slate-200/80 dark:border-white/10">
               <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 13l4 4L19 7"></path></svg>
               <span class="text-sm text-slate-600 dark:text-slate-300">${pkg.duration}</span>
            </div>
          </div>
        `;
        grid.insertAdjacentHTML('beforeend', html);
      });

      // Bind events to new cards
      document.querySelectorAll('.package-card').forEach(card => {
        card.addEventListener('click', (e) => {
          document.querySelectorAll('.package-card').forEach(el => el.classList.remove('ring-1', 'ring-2', 'ring-brand-blue', 'ring-brand-blue/70'));
          card.classList.add('ring-1', 'ring-brand-blue/70');
          document.getElementById('package_name').value = card.getAttribute('data-pkg');
          document.getElementById('package_price').value = card.getAttribute('data-price');
          document.getElementById('err-step2').classList.add('hidden');
          
          // Auto advance ONLY if the user clicked the 'Pilih Paket' button
          if (e.target.closest('.select-pkg-btn')) {
            document.getElementById('btnNext').click();
          }
        });
      });
    }

    // Initialize Website Types
    const gridType = document.getElementById('websiteTypeGrid');
    const typeCardBaseClass = "type-card group min-h-[5.25rem] w-full rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-white/5 px-4 py-3 text-left cursor-pointer transition-all hover:border-brand-blue hover:bg-blue-50/60 dark:hover:bg-brand-blue/10 focus:outline-none focus:ring-2 focus:ring-brand-blue/40";
    const typeCardActiveClass = ['border-brand-blue', 'bg-blue-50', 'dark:bg-brand-blue/10', 'ring-1', 'ring-brand-blue/40'];

    websiteTypes.forEach(type => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = typeCardBaseClass;
      button.setAttribute('aria-pressed', 'false');
      button.innerHTML = `
        <span class="flex items-center justify-between gap-4">
          <span class="text-sm sm:text-base font-semibold leading-snug text-slate-900 dark:text-white">${type}</span>
          <span class="type-check flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-slate-300 dark:border-slate-600 bg-white dark:bg-[#0a111f] text-transparent transition-all group-hover:border-brand-blue">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
          </span>
        </span>
      `;
      button.onclick = () => {
        document.querySelectorAll('.type-card').forEach(el => {
          el.classList.remove(...typeCardActiveClass);
          el.setAttribute('aria-pressed', 'false');
          const check = el.querySelector('.type-check');
          check.className = 'type-check flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-slate-300 dark:border-slate-600 bg-white dark:bg-[#0a111f] text-transparent transition-all group-hover:border-brand-blue';
        });

        button.classList.add(...typeCardActiveClass);
        button.setAttribute('aria-pressed', 'true');
        button.querySelector('.type-check').className = 'type-check flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-brand-blue bg-brand-blue text-white transition-all shadow-sm';
        document.getElementById('website_type').value = type;
        document.getElementById('err-step1').classList.add('hidden');
        renderPricing(type); // Render dynamic pricing cards!
      };
      gridType.appendChild(button);
    });

    // Design preference selectors
    const colorOptionActiveClass = ['border-brand-blue', 'bg-blue-50/70', 'ring-1', 'ring-brand-blue/30', 'dark:bg-brand-blue/10'];
    const designStyleActiveClass = ['border-brand-blue', 'bg-blue-50/70', 'ring-1', 'ring-brand-blue/30', 'dark:bg-brand-blue/10'];
    const inactiveStyleCheckClass = 'style-check flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-slate-300 bg-white text-transparent transition-colors dark:border-slate-600 dark:bg-slate-900';
    const activeStyleCheckClass = 'style-check flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-brand-blue bg-brand-blue text-white transition-colors';

    function selectColorOption(option) {
      if (!option) return;
      document.querySelectorAll('.color-option').forEach(item => {
        item.classList.remove(...colorOptionActiveClass);
        const check = item.querySelector('.color-check');
        if (check) check.classList.add('hidden');
      });
      option.classList.add(...colorOptionActiveClass);
      const activeCheck = option.querySelector('.color-check');
      if (activeCheck) activeCheck.classList.remove('hidden');
      document.getElementById('primary_color').value = option.dataset.color;
    }

    function selectDesignStyle(option) {
      if (!option) return;
      document.querySelectorAll('.design-style-option').forEach(item => {
        item.classList.remove(...designStyleActiveClass);
        item.setAttribute('aria-pressed', 'false');
        const check = item.querySelector('.style-check');
        if (check) check.className = inactiveStyleCheckClass;
      });
      option.classList.add(...designStyleActiveClass);
      option.setAttribute('aria-pressed', 'true');
      const activeCheck = option.querySelector('.style-check');
      if (activeCheck) activeCheck.className = activeStyleCheckClass;
      document.getElementById('design_style').value = option.dataset.style;
    }

    document.addEventListener('click', (event) => {
      const colorOption = event.target.closest('.color-option');
      if (colorOption) selectColorOption(colorOption);

      const designOption = event.target.closest('.design-style-option');
      if (designOption) selectDesignStyle(designOption);
    });

    const customColorInput = document.getElementById('customColorInput');
    const customColorOption = document.getElementById('customColorOption');
    const customColorValue = document.getElementById('customColorValue');
    const customColorPreview = document.getElementById('customColorPreview');

    if (customColorInput && customColorOption) {
      customColorInput.addEventListener('input', () => {
        const color = customColorInput.value.toUpperCase();
        customColorOption.dataset.color = color;
        customColorValue.textContent = color;
        customColorPreview.style.backgroundColor = color;
        selectColorOption(customColorOption);
      });
    }

    const firstColorOption = document.querySelector('.color-option');
    const firstDesignOption = document.querySelector('.design-style-option');
    selectColorOption(firstColorOption);
    selectDesignStyle(firstDesignOption);
    // File Upload Handler with Drag & Drop styling
    const dropzone = document.getElementById('dropzone');
    const fileUpload = document.getElementById('fileUpload');
    
    fileUpload.addEventListener('dragenter', () => dropzone.classList.add('border-brand-blue', 'bg-blue-50', 'dark:bg-brand-blue/10'));
    fileUpload.addEventListener('dragleave', () => dropzone.classList.remove('border-brand-blue', 'bg-blue-50', 'dark:bg-brand-blue/10'));
    fileUpload.addEventListener('drop', () => dropzone.classList.remove('border-brand-blue', 'bg-blue-50', 'dark:bg-brand-blue/10'));

    fileUpload.addEventListener('change', async (e) => {
      const files = e.target.files;
      if (!files || files.length === 0) return;
      
      const formData = new FormData();
      for (let i = 0; i < files.length; i++) {
        formData.append("files", files[i]);
      }
      
      const btnNext = document.getElementById('btnNext');
      btnNext.innerText = "Mengunggah...";
      btnNext.disabled = true;

      try {
        const res = await fetch('/api/upload/document', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success) {
          // Append URLs to hidden input (comma separated if multiple uploads occur)
          const currentUrls = document.getElementById('uploadedFileUrl').value;
          document.getElementById('uploadedFileUrl').value = currentUrls ? currentUrls + ',' + data.url : data.url;
          
          const uploadedUrls = data.url.split(',');

          // Render uploaded files UI
          const statusContainer = document.getElementById('uploadStatus');
          for (let i = 0; i < files.length; i++) {
            const fileRow = document.createElement('div');
            fileRow.className = "flex items-center justify-between bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 rounded-lg";
            fileRow.dataset.fileUrl = uploadedUrls[i];
            const safeUrl = uploadedUrls[i].replace(/'/g, "\\'");
            const safeName = files[i].name.replace(/'/g, "\\'");
            fileRow.innerHTML = `
              <div class="flex items-center gap-3 overflow-hidden">
                <svg class="w-5 h-5 text-brand-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <div class="truncate text-sm font-semibold text-slate-700 dark:text-slate-300">${files[i].name}</div>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" class="text-blue-500 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors p-1" onclick="viewUploadedFile('${safeUrl}', '${safeName}')" title="Lihat File" aria-label="Lihat file">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                </button>
                <button type="button" class="text-slate-400 hover:text-red-500 dark:text-slate-500 dark:hover:text-red-400 transition-colors p-1" onclick="removeUploadedFile(this, '${safeUrl}')" title="Hapus File" aria-label="Hapus file">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m-7 0a1 1 0 001-1V5a1 1 0 011-1h4a1 1 0 011 1v1a1 1 0 001 1m-8 0h8"></path></svg>
                </button>
              </div>
            `;
            statusContainer.appendChild(fileRow);
          }
        } else {
          alert("Gagal mengunggah file.");
        }
      } catch (err) {
        alert("Terjadi kesalahan koneksi saat unggah.");
      } finally {
        btnNext.innerText = "Lanjutkan";
        btnNext.disabled = false;
        fileUpload.value = ''; // Reset input to allow uploading same files again
      }
    });

    // Navigation Logic
    let currentStep = 1;
    const totalSteps = 5;

    const btnPrev = document.getElementById('btnPrev');
    const btnNext = document.getElementById('btnNext');
    const btnSubmit = document.getElementById('btnSubmit');
    const orderPage = document.getElementById('orderPage');
    const flowPage = document.getElementById('flowPage');
    const orderNavBtn = document.getElementById('orderNavBtn');
    const flowNavBtn = document.getElementById('flowNavBtn');
    const languageToggle = document.getElementById('languageToggle');
    const backToOrderBtn = document.getElementById('backToOrderBtn');
    const navActiveIndicator = document.getElementById('navActiveIndicator');
    const navActiveClasses = ['text-slate-900', 'dark:text-white'];
    let activeNavButton = orderNavBtn;

    function setNavActive(activeButton) {
      [orderNavBtn, flowNavBtn].forEach((button) => button.classList.remove(...navActiveClasses));
      activeButton.classList.add(...navActiveClasses);
      activeNavButton = activeButton;
      navActiveIndicator.style.width = `${activeButton.offsetWidth}px`;
      navActiveIndicator.style.transform = `translateX(${activeButton.offsetLeft - 8}px)`;
    }

    window.addEventListener('resize', () => setNavActive(activeNavButton));

    function showOrderPage() {
      flowPage.classList.add('hidden');
      orderPage.classList.remove('hidden');
      setNavActive(orderNavBtn);
      window.scrollTo(0, 0);
    }

    function showFlowPage() {
      orderPage.classList.add('hidden');
      flowPage.classList.remove('hidden');
      setNavActive(flowNavBtn);
      window.scrollTo(0, 0);
    }

    function setTranslateCookie(language) {
      const value = language === 'en' ? '/id/en' : '/id/id';
      document.cookie = `googtrans=${value};path=/`;
      document.cookie = `googtrans=${value};domain=${location.hostname};path=/`;
    }

    function switchLanguage() {
      const isEnglish = document.cookie.includes('googtrans=/id/en');
      const nextLanguage = isEnglish ? 'id' : 'en';
      const select = document.querySelector('.goog-te-combo');

      if (select) {
        select.value = nextLanguage;
        select.dispatchEvent(new Event('change'));
      } else {
        setTranslateCookie(nextLanguage);
        window.location.reload();
      }
    }

    orderNavBtn.addEventListener('click', showOrderPage);
    flowNavBtn.addEventListener('click', showFlowPage);
    languageToggle.addEventListener('click', switchLanguage);
    backToOrderBtn.addEventListener('click', showOrderPage);
    setNavActive(orderNavBtn);

    // Payment Proof Upload Handler
    document.getElementById('paymentProofUpload').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      
      const formData = new FormData();
      formData.append("files", file);
      
      btnSubmit.innerHTML = "Mengunggah...";
      btnSubmit.disabled = true;

      try {
        const res = await fetch('/api/upload/payment', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success) {
          document.getElementById('paymentProofUrl').value = data.url;
          document.getElementById('paymentUploadStatus').classList.remove('hidden');
        } else {
          alert("Gagal mengunggah bukti pembayaran.");
        }
      } catch (err) {
        alert("Terjadi kesalahan koneksi saat unggah bukti pembayaran.");
      } finally {
        btnSubmit.innerHTML = "Kirim";
        btnSubmit.disabled = false;
      }
    });

    function updateUI() {
      // Show/Hide steps
      for (let i = 1; i <= totalSteps; i++) {
        document.getElementById(`step${i}`).classList.toggle('hidden', i !== currentStep);
      }
      
      // Update vertical stepper
      document.querySelectorAll('.step-indicator').forEach(ind => {
        const stepNum = parseInt(ind.getAttribute('data-step'));
        const dot = ind.querySelector('.step-dot');
        const title = ind.querySelector('.step-title');
        const subtitle = ind.querySelector('.step-subtitle');
        const line = ind.querySelector('.step-line');
        const isDone = stepNum < currentStep;
        const isCurrent = stepNum === currentStep;

        if (isDone) {
          dot.className = "step-dot relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/95 dark:bg-slate-900/95 text-slate-950 dark:text-white transition-all";
          dot.innerHTML = '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>';
          title.className = "step-title text-base font-semibold leading-tight text-slate-900 dark:text-white transition-colors";
          subtitle.className = "step-subtitle mt-1 text-sm leading-snug text-slate-500 dark:text-slate-400 transition-colors";
          if (line) line.className = "absolute left-5 top-11 bottom-0 w-px bg-slate-300/60 dark:bg-white/10 step-line";
        } else if (isCurrent) {
          dot.className = "step-dot relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/95 dark:bg-slate-900/95 text-slate-950 dark:text-white transition-all";
          dot.innerHTML = '<span class="h-5 w-5 rounded-full border-2 border-dotted border-slate-950 dark:border-white"></span>';
          title.className = "step-title text-base font-semibold leading-tight text-slate-900 dark:text-white transition-colors";
          subtitle.className = "step-subtitle mt-1 text-sm leading-snug text-slate-500 dark:text-slate-400 transition-colors";
          if (line) line.className = "absolute left-5 top-11 bottom-0 w-px bg-slate-300/60 dark:bg-white/10 step-line";
        } else {
          dot.className = "step-dot relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#efefef] dark:bg-slate-900/70 text-sm font-semibold text-slate-500 dark:text-slate-500 transition-all";
          dot.textContent = stepNum;
          title.className = "step-title text-base font-semibold leading-tight text-slate-500 dark:text-slate-500 transition-colors";
          subtitle.className = "step-subtitle mt-1 text-sm leading-snug text-slate-500/80 dark:text-slate-600 transition-colors";
          if (line) line.className = "absolute left-5 top-11 bottom-0 w-px bg-slate-300/60 dark:bg-white/10 step-line";
        }
      });

      // Show/Hide Buttons
      btnPrev.classList.toggle('hidden', currentStep === 1);
      if (currentStep === totalSteps) {
        btnNext.classList.add('hidden');
        btnSubmit.classList.remove('hidden');
        
        // Populate Summary
        document.getElementById('summary-type').innerText = document.getElementById('website_type').value || '-';
        document.getElementById('summary-name').innerText = document.getElementById('project_name').value || '-';
        document.getElementById('summary-package').innerText = document.getElementById('package_name').value || '-';
        document.getElementById('summary-desc').innerText = document.getElementById('description').value || '-';
        document.getElementById('summary-features').innerText = document.getElementById('features').value || '-';
        document.getElementById('summary-target').innerText = document.getElementById('target_date').value || 'Tidak ada target';
        
        const activeColorOpt = document.querySelector('.color-option.border-brand-blue');
        if (activeColorOpt) {
          const colorName = activeColorOpt.dataset.name || 'Warna Custom';
          const colorHex = activeColorOpt.dataset.color || '#243CFF';
          document.getElementById('summary-color').innerHTML = `<span class="w-4 h-4 rounded-full inline-block shadow-sm ring-1 ring-slate-200 dark:ring-white/20" style="background-color: ${colorHex};"></span> ${colorName}`;
        }
        
        document.getElementById('summary-style').innerText = document.getElementById('design_style').value || '-';

        const priceStr = document.getElementById('package_price').value || 'Rp. 0';
        document.getElementById('summary-price').innerText = priceStr;
        
        // Parsing price to calculate DP
        const numPrice = parseInt(priceStr.replace(/[^0-9]/g, '')) || 0;
        if (numPrice > 0) {
          const dpPrice = numPrice / 2;
          const formatRupiah = (angka) => {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);
          };
          const isPlus = priceStr.includes('+');
          document.getElementById('summary-dp').innerText = formatRupiah(dpPrice) + (isPlus ? '+' : '');
          document.getElementById('summary-final').innerText = formatRupiah(dpPrice) + (isPlus ? '+' : '');
        } else {
          document.getElementById('summary-dp').innerText = 'Hubungi Admin';
          document.getElementById('summary-final').innerText = 'Hubungi Admin';
        }
      } else {
        btnNext.classList.remove('hidden');
        btnSubmit.classList.add('hidden');
      }
    }

    function validateStep() {
      if (currentStep === 1 && !document.getElementById('website_type').value) {
        document.getElementById('err-step1').classList.remove('hidden'); return false;
      }
      if (currentStep === 2 && !document.getElementById('package_name').value) {
        document.getElementById('err-step2').classList.remove('hidden'); return false;
      }
      if (currentStep === 3) {
        if (!document.getElementById('project_name').value || !document.getElementById('description').value) {
          document.getElementById('project_name').reportValidity();
          document.getElementById('description').reportValidity();
          return false;
        }
      }
      return true;
    }

    btnNext.addEventListener('click', () => {
      if (validateStep() && currentStep < totalSteps) {
        currentStep++;
        updateUI();
        window.scrollTo(0,0);
      }
    });

    btnPrev.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--;
        updateUI();
        window.scrollTo(0,0);
      }
    });

    updateUI();

    document.getElementById('orderForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const paymentProofUrl = document.getElementById('paymentProofUrl').value;
      if (!paymentProofUrl) {
        showToastNotification();
        return;
      }
      
      btnSubmit.innerHTML = "Memproses...";
      btnSubmit.disabled = true;

      const payload = {
        website_type: document.getElementById('website_type').value,
        package_name: document.getElementById('package_name').value,
        project_name: document.getElementById('project_name').value,
        description: document.getElementById('description').value,
        features: document.getElementById('features').value,
        target_date: document.getElementById('target_date').value,
        notes: document.getElementById('notes').value,
        files: document.getElementById('uploadedFileUrl').value ? document.getElementById('uploadedFileUrl').value.split(',') : [],
        project_document: document.getElementById('uploadedFileUrl').value || '',
        reference_links: document.getElementById('reference_links').value,
        primary_color: document.getElementById('primary_color').value,
        design_style: document.getElementById('design_style').value,
        payment_proof: paymentProofUrl
      };

      try {
        const res = await fetch('/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          const modal = document.getElementById('successModal');
          modal.classList.remove('hidden');
          setTimeout(() => modal.classList.remove('opacity-0'), 10);
        } else {
          alert(data.message || "Gagal menyimpan pesanan.");
        }
      } catch(err) {
        alert("Kesalahan jaringan.");
      } finally {
        btnSubmit.innerHTML = "Kirim";
        btnSubmit.disabled = false;
      }
    });

  </script>
  <script>
    // Theme Toggle Logic
    const themeToggleBtn = document.getElementById('themeToggle');
    const themeIconDark = document.getElementById('themeIconDark');
    const themeIconLight = document.getElementById('themeIconLight');

    function updateThemeIcon() {
      if (document.documentElement.classList.contains('dark')) {
        themeIconLight.classList.remove('hidden');
        themeIconDark.classList.add('hidden');
      } else {
        themeIconDark.classList.remove('hidden');
        themeIconLight.classList.add('hidden');
      }
    }
    
    // Initial icon state
    updateThemeIcon();

    themeToggleBtn.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      if (document.documentElement.classList.contains('dark')) {
        localStorage.theme = 'dark';
      } else {
        localStorage.theme = 'light';
      }
      updateThemeIcon();
    });

    // Modal Viewer Functions
    function showToastNotification() {
      const toast = document.getElementById('toastNotification');
      toast.classList.remove('-translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('-translate-y-20', 'opacity-0');
      }, 3000);
    }

    function removeUploadedFile(button, url) {
      const uploadedInput = document.getElementById('uploadedFileUrl');
      const fileRow = button.closest('[data-file-url]');
      const urls = uploadedInput.value ? uploadedInput.value.split(',') : [];
      uploadedInput.value = urls.filter(item => item !== url).join(',');
      if (fileRow) fileRow.remove();
    }
    function viewUploadedFile(url, name) {
      const modal = document.getElementById('fileViewerModal');
      const container = document.getElementById('fileViewerContainer');
      const title = document.getElementById('fileViewerTitle');
      const content = document.getElementById('fileViewerContent');
      
      title.innerText = name;
      content.innerHTML = ''; // clear previous
      
      const ext = url.split('.').pop().toLowerCase();
      if (['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg'].includes(ext)) {
        content.innerHTML = `<img src="${url}" class="max-w-full max-h-[70vh] object-contain rounded-lg shadow-md" alt="${name}">`;
      } else if (ext === 'pdf') {
        content.innerHTML = `<iframe src="${url}" class="w-full h-[70vh] rounded-lg shadow-md border-0"></iframe>`;
      } else {
        content.innerHTML = `
          <div class="text-center">
            <svg class="w-16 h-16 text-slate-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <p class="text-slate-600 dark:text-slate-300 mb-4">Pratinjau tidak tersedia untuk format file ini.</p>
            <a href="${url}" target="_blank" class="px-6 py-2 bg-brand-blue text-white rounded-lg font-semibold hover:bg-blue-600 transition-colors inline-block">Unduh File</a>
          </div>`;
      }
      
      modal.classList.remove('hidden');
      // small delay to allow display:block to apply before animating opacity/transform
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        container.classList.remove('scale-95');
        container.classList.add('scale-100');
      }, 10);
    }
    
    function closeFileViewer() {
      const modal = document.getElementById('fileViewerModal');
      const container = document.getElementById('fileViewerContainer');
      
      modal.classList.add('opacity-0');
      container.classList.remove('scale-100');
      container.classList.add('scale-95');
      
      setTimeout(() => {
        modal.classList.add('hidden');
        document.getElementById('fileViewerContent').innerHTML = '';
      }, 300);
    }
  </script>
  <script>
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({ pageLanguage: 'id', includedLanguages: 'id,en', autoDisplay: false }, 'google_translate_element');
    }
  </script>
  <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</body>
</html>













