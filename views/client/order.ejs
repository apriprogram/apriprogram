<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pesan Website - Apriprogram</title>
  <link rel="icon" href="/assets/logo/favicon.png" type="image/png">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    // Theme setup to prevent FOUC
    if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          fontFamily: { sans: ['Poppins', 'sans-serif'] },
          colors: { brand: { blue: "#243CFF", cyan: "#22D3EE", card: "#0a111f", border: "rgba(255,255,255,0.05)" } }
        }
      }
    };
  </script>
  <style>
    body {
      background-color: #efefef;
      background-image: radial-gradient(circle, rgba(148, 163, 184, 0.22) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    html.dark body {
      background-color: #050b14;
      background-image: radial-gradient(circle, rgba(148, 163, 184, 0.12) 1px, transparent 1px);
    }
  </style></head>
<body class="bg-[#efefef] dark:bg-[#050b14] text-slate-900 dark:text-white min-h-screen flex flex-col">
  <div id="google_translate_element" class="hidden"></div>

  <!-- Header -->
  <header class="fixed left-1/2 top-4 z-50 w-[calc(100%-2rem)] max-w-2xl -translate-x-1/2">
    <nav id="mainNav" class="relative flex items-center justify-between rounded-full border border-white/70 bg-[#efefef]/75 px-2 py-2 text-slate-700 shadow-[0_8px_24px_rgba(15,23,42,0.06)] backdrop-blur-2xl dark:border-white/10 dark:bg-slate-900/55 dark:text-slate-200 dark:shadow-[0_8px_24px_rgba(0,0,0,0.18)]">
      <span id="navActiveIndicator" class="absolute top-2 bottom-2 left-2 rounded-full bg-white/80 transition-all duration-300 ease-out dark:bg-white/10"></span>
      <a href="/" class="relative z-10 flex h-11 items-center gap-2 rounded-full px-4 text-sm font-semibold text-slate-600 transition-colors duration-300 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white" aria-label="Home">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9z"></path></svg>
        <span>Home</span>
      </a>
      <button type="button" id="orderNavBtn" class="relative z-10 flex h-11 items-center gap-2 rounded-full px-4 text-sm font-semibold text-slate-600 transition-colors duration-300 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white" aria-label="Form Pemesanan">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5h6m-7 4h8m-8 4h5m-7 8h12a2 2 0 002-2V7.5L15.5 3H6a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        <span class="hidden sm:inline">Form Pemesanan</span>
      </button>
      <button type="button" id="flowNavBtn" class="relative z-10 flex h-11 items-center gap-2 rounded-full px-4 text-sm font-semibold text-slate-600 transition-colors duration-300 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white" aria-label="Alur">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h6m4 0h6M4 12h10m4 0h2M4 18h4m4 0h8"></path></svg>
        <span class="hidden sm:inline">Alur</span>
      </button>
      <button type="button" id="languageToggle" class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full text-slate-600 transition-colors hover:bg-white/60 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white dark:focus:ring-white/20" aria-label="Ganti Bahasa" title="Ganti bahasa">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 015.412 9m6.176 0A18.023 18.023 0 017 16m8-5h6m-3-3v3m0 0v3m0-3h3m-3 0h-3"></path></svg>
      </button>
      <button id="themeToggle" class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full text-slate-600 transition-colors hover:bg-white/60 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white dark:focus:ring-white/20" aria-label="Toggle Dark Mode">
        <svg id="themeIconDark" class="h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        <svg id="themeIconLight" class="h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
      </button>
      <a href="/logout" class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full text-slate-600 transition-colors hover:bg-white/60 hover:text-red-500 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-red-400" title="Logout <%= user.email %>" aria-label="Logout">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H9m4 8H6a2 2 0 01-2-2V6a2 2 0 012-2h7"></path></svg>
      </a>
    </nav>
  </header>

  <div class="fixed left-4 top-4 z-40 hidden max-w-sm items-center gap-4 text-slate-900 dark:text-white lg:flex">
    <img src="/assets/logo/apriprogram.png" alt="Apriprogram" class="h-9 w-auto shrink-0" onerror="this.style.display='none'">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-slate-950 dark:text-white">Selamat datang</p>
      <p class="mt-0.5 text-xs leading-snug text-slate-500 dark:text-slate-400">Silakan lengkapi form pemesanan website sesuai kebutuhan proyek Anda.</p>
    </div>
  </div>

  <div class="fixed right-4 top-4 z-40 hidden items-center gap-3 text-right text-slate-900 dark:text-white lg:flex">
    <div class="min-w-0">
      <p class="max-w-56 truncate text-sm font-semibold text-slate-950 dark:text-white"><%= user.full_name || (user.email ? user.email.split('@')[0] : 'User') %></p>
      <p class="max-w-56 truncate text-xs text-slate-500 dark:text-slate-400"><%= user.email %></p>
    </div>
    <div class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white text-sm font-semibold text-slate-900 ring-1 ring-slate-200 dark:bg-white dark:text-slate-900 dark:ring-white/20">
      <% if (user.avatar) { %>
        <img src="<%= user.avatar %>" alt="Foto profil" class="h-full w-full object-cover">
      <% } else { %>
        <%= (user.full_name || (user.email ? user.email.split('@')[0] : 'U')).trim().charAt(0).toUpperCase() %>
      <% } %>
    </div>
  </div>

  <main id="orderPage" class="flex-grow max-w-[86rem] w-full mx-auto p-6 pt-24 lg:py-10 lg:pt-28">
    <div class="grid grid-cols-1 lg:grid-cols-[15rem_minmax(0,1fr)] gap-8 lg:gap-12 items-start">
      <!-- Steps Indicator -->
      <aside class="px-1 sm:px-2 lg:sticky lg:top-32 lg:self-start">
        <div class="space-y-1">
          <div class="relative step-indicator flex gap-4 pb-9" data-step="1">
            <div class="absolute left-5 top-11 bottom-0 w-px bg-slate-300/60 dark:bg-white/10 step-line"></div>
            <div class="step-dot relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#efefef] dark:bg-slate-900/70 text-sm font-semibold text-slate-500 dark:text-slate-500 transition-all">1</div>
            <div class="min-w-0 pt-0.5">
              <div class="step-title text-base font-semibold leading-tight text-slate-900 dark:text-white transition-colors">Jenis Website</div>
              <div class="step-subtitle mt-1 text-sm leading-snug text-slate-500 dark:text-slate-400 transition-colors">Pilih kategori website</div>
            </div>
          </div>
          <div class="relative step-indicator flex gap-4 pb-9" data-step="2">
            <div class="absolute left-5 top-11 bottom-0 w-px bg-slate-300/60 dark:bg-white/10 step-line"></div>
            <div class="step-dot relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#efefef] dark:bg-slate-900/70 text-sm font-semibold text-slate-500 dark:text-slate-500 transition-all">2</div>
            <div class="min-w-0 pt-0.5">
              <div class="step-title text-base font-semibold leading-tight text-slate-900 dark:text-white transition-colors">Paket Website</div>
              <div class="step-subtitle mt-1 text-sm leading-snug text-slate-500 dark:text-slate-400 transition-colors">Pilih layanan terbaik</div>
            </div>
          </div>
          <div class="relative step-indicator flex gap-4 pb-9" data-step="3">
            <div class="absolute left-5 top-11 bottom-0 w-px bg-slate-300/60 dark:bg-white/10 step-line"></div>
            <div class="step-dot relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#efefef] dark:bg-slate-900/70 text-sm font-semibold text-slate-500 dark:text-slate-500 transition-all">3</div>
            <div class="min-w-0 pt-0.5">
              <div class="step-title text-base font-semibold leading-tight text-slate-900 dark:text-white transition-colors">Briefing</div>
              <div class="step-subtitle mt-1 text-sm leading-snug text-slate-500 dark:text-slate-400 transition-colors">Detail kebutuhan proyek</div>
            </div>
          </div>
          <div class="relative step-indicator flex gap-4 pb-9" data-step="4">
            <div class="absolute left-5 top-11 bottom-0 w-px bg-slate-300/60 dark:bg-white/10 step-line"></div>
            <div class="step-dot relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#efefef] dark:bg-slate-900/70 text-sm font-semibold text-slate-500 dark:text-slate-500 transition-all">4</div>
            <div class="min-w-0 pt-0.5">
              <div class="step-title text-base font-semibold leading-tight text-slate-900 dark:text-white transition-colors">Desain</div>
              <div class="step-subtitle mt-1 text-sm leading-snug text-slate-500 dark:text-slate-400 transition-colors">Preferensi visual</div>
            </div>
          </div>
          <div class="relative step-indicator flex gap-4" data-step="5">
            <div class="step-dot relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#efefef] dark:bg-slate-900/70 text-sm font-semibold text-slate-500 dark:text-slate-500 transition-all">5</div>
            <div class="min-w-0 pt-0.5">
              <div class="step-title text-base font-semibold leading-tight text-slate-900 dark:text-white transition-colors">Ringkasan</div>
              <div class="step-subtitle mt-1 text-sm leading-snug text-slate-500 dark:text-slate-400 transition-colors">Konfirmasi pesanan</div>
            </div>
          </div>
        </div>

        <div class="mt-8 border-t border-slate-200/80 dark:border-slate-800 pt-5 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          Butuh bantuan? <a href="https://wa.me/6282181361433?text=Halo%20Apriprogram%2C%20saya%20ingin%20bertanya%20tentang%20pemesanan%20website.%20Bisa%20dibantu%20untuk%20pilihan%20paket%2C%20fitur%2C%20estimasi%20waktu%2C%20dan%20alur%20pemesanan%3F" target="_blank" rel="noopener" class="font-semibold text-slate-900 dark:text-white underline underline-offset-4 hover:text-brand-blue dark:hover:text-brand-cyan transition-colors">Hubungi support</a>
        </div>
      </aside>

      <!-- Forms Container -->
      <section class="relative min-w-0 px-1 sm:px-2 lg:pt-5">
        <form id="orderForm">
        
        <!-- STEP 1: Jenis Website -->
        <div class="step-content block" id="step1">
          <h2 class="text-2xl font-semibold mb-2">Pilih Jenis Website</h2>
          <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">Pilih kategori yang paling sesuai dengan kebutuhan proyek Anda.</p>
          
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4" id="websiteTypeGrid">
            <!-- JS will populate options here -->
          </div>
          <input type="hidden" id="website_type" required>
          <p id="err-step1" class="text-red-500 text-sm mt-3 hidden">Pilih salah satu jenis website terlebih dahulu.</p>
        </div>

        <!-- STEP 2: Pilih Paket -->
        <div class="step-content hidden" id="step2">
          <h2 class="text-2xl font-semibold mb-2">Pilih Paket Website</h2>
          <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">Pilih paket yang sesuai dengan fitur dan budget yang Anda inginkan.</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="packagesGrid">
            <!-- JS will populate pricing cards here based on selected website type -->
          </div>
          <input type="hidden" id="package_name" required>
          <input type="hidden" id="package_price" required>
          <p id="err-step2" class="text-red-500 text-sm mt-3 hidden">Pilih salah satu paket terlebih dahulu.</p>
        </div>

        <!-- STEP 3: Isi Brief & Upload -->
        <div class="step-content hidden" id="step3">
          <h2 class="text-2xl font-semibold mb-2">Brief Proyek</h2>
          <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">Ceritakan lebih detail tentang website yang ingin Anda buat.</p>
          
          <div class="space-y-5">
            <div>
              <label class="block text-sm font-semibold mb-2 text-slate-800 dark:text-slate-200">Nama Proyek / Website *</label>
              <input type="text" id="project_name" required class="w-full px-4 py-3 bg-white dark:bg-[#0a111f] border border-slate-300 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none text-sm transition-all text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500">
            </div>
            <div>
              <label class="block text-sm font-semibold mb-2 text-slate-800 dark:text-slate-200">Deskripsi Singkat *</label>
              <textarea id="description" rows="3" required class="w-full px-4 py-3 bg-white dark:bg-[#0a111f] border border-slate-300 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none text-sm transition-all text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" placeholder="Tujuan website ini untuk apa?"></textarea>
            </div>
            <div>
              <label class="block text-sm font-semibold mb-2 text-slate-800 dark:text-slate-200">Fitur yang Dibutuhkan</label>
              <textarea id="features" rows="2" class="w-full px-4 py-3 bg-white dark:bg-[#0a111f] border border-slate-300 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none text-sm transition-all text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" placeholder="Contoh: Live Chat, Kalkulator Harga, dll."></textarea>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-semibold mb-2 text-slate-800 dark:text-slate-200">Target Penyelesaian (Opsional)</label>
                <input type="date" id="target_date" class="w-full px-4 py-3 bg-white dark:bg-[#0a111f] border border-slate-300 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none text-sm transition-all text-slate-900 dark:text-white">
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold mb-2 text-slate-800 dark:text-slate-200">Upload Document Project</label>
              <div class="w-full border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-xl bg-slate-50 dark:bg-[#0a111f] p-8 text-center hover:bg-slate-100 dark:hover:bg-white/5 transition-colors cursor-pointer relative mt-2 group" id="dropzone">
                 <input type="file" id="fileUpload" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip,.rar" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                 <div class="mb-3">
                   <div class="w-12 h-12 bg-slate-200 dark:bg-slate-800 text-slate-500 rounded-full flex items-center justify-center mx-auto shadow-sm group-hover:scale-110 transition-transform">
                     <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                   </div>
                 </div>
                 <h4 class="text-sm font-semibold text-slate-700 dark:text-slate-200 mb-1">Choose a file or drag & drop it here.</h4>
                 <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">txt, docx, pdf, jpeg, xlsx, zip - Up to 50MB</p>
                 <button type="button" class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm font-semibold text-slate-700 dark:text-slate-200 pointer-events-none shadow-sm">Browse files</button>
              </div>
              <input type="hidden" id="uploadedFileUrl">
              <div id="uploadStatus" class="mt-3 space-y-2"></div>
            </div>
          </div>
        </div>

        <!-- STEP 4: Desain & Referensi -->
        <div class="step-content hidden" id="step4">
          <h2 class="text-2xl font-semibold mb-2">Tema & Referensi Desain</h2>
          <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">Bantu kami memahami selera visual Anda.</p>
          
          <div class="space-y-5">
            <div>
              <label class="block text-sm font-semibold mb-2 text-slate-800 dark:text-slate-200">Link Website Referensi (Bila Ada)</label>
              <textarea id="reference_links" rows="5" class="w-full min-h-36 px-4 py-3 bg-white dark:bg-[#0a111f] border border-slate-300 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none text-sm transition-all text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" placeholder="Sebutkan link website yang Anda jadikan contoh/inspirasi..."></textarea>
            </div>
            <div>
              <label class="block text-sm font-semibold mb-3 text-slate-800 dark:text-slate-200">Warna Utama</label>
              <input type="hidden" id="primary_color" value="#243CFF">
              <div id="colorPickerGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                <button type="button" data-color="#243CFF" data-name="Biru Apriprogram" class="color-option group flex min-h-[4.75rem] items-center justify-between rounded-xl border border-slate-200/80 bg-white px-4 py-3 text-left transition-colors hover:border-brand-blue dark:border-white/10 dark:bg-[#0a111f] dark:hover:border-brand-blue">
                  <span><span class="block text-sm font-semibold text-slate-950 dark:text-white">Biru Apriprogram</span><span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">#243CFF</span></span>
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#243CFF] ring-1 ring-slate-200 dark:ring-white/10"><svg class="color-check hidden h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></span>
                </button>
                <button type="button" data-color="#0F172A" data-name="Hitam Elegan" class="color-option group flex min-h-[4.75rem] items-center justify-between rounded-xl border border-slate-200/80 bg-white px-4 py-3 text-left transition-colors hover:border-brand-blue dark:border-white/10 dark:bg-[#0a111f] dark:hover:border-brand-blue">
                  <span><span class="block text-sm font-semibold text-slate-950 dark:text-white">Hitam Elegan</span><span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">#0F172A</span></span>
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#0F172A] ring-1 ring-slate-200 dark:ring-white/10"><svg class="color-check hidden h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></span>
                </button>
                <button type="button" data-color="#16A34A" data-name="Hijau Fresh" class="color-option group flex min-h-[4.75rem] items-center justify-between rounded-xl border border-slate-200/80 bg-white px-4 py-3 text-left transition-colors hover:border-brand-blue dark:border-white/10 dark:bg-[#0a111f] dark:hover:border-brand-blue">
                  <span><span class="block text-sm font-semibold text-slate-950 dark:text-white">Hijau Fresh</span><span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">#16A34A</span></span>
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#16A34A] ring-1 ring-slate-200 dark:ring-white/10"><svg class="color-check hidden h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></span>
                </button>
                <button type="button" data-color="#EA580C" data-name="Oranye Hangat" class="color-option group flex min-h-[4.75rem] items-center justify-between rounded-xl border border-slate-200/80 bg-white px-4 py-3 text-left transition-colors hover:border-brand-blue dark:border-white/10 dark:bg-[#0a111f] dark:hover:border-brand-blue">
